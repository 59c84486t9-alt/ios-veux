From: ios-veux
Subject: [PATCH] Enable the portable legacy AES provider on VEUX

SWEET's BearSSL-backed CBC/ECB implementation avoids the null corecrypto
function table for legacy AES APIs. BearSSL is already staged for VEUX; include
VEUX in the provider guards and its include/compiler settings.

diff --git a/libkern/crypto/corecrypto_aes.c b/libkern/crypto/corecrypto_aes.c
--- a/libkern/crypto/corecrypto_aes.c
+++ b/libkern/crypto/corecrypto_aes.c
@@ -32,8 +32,8 @@
 #include <corecrypto/ccaes.h>
 #include <kern/debug.h>
 
-#if defined(ARM64_BOARD_CONFIG_SWEET)
-/* SWEET has a built-in portable AES provider for the legacy CBC/ECB API. */
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_VEUX)
+/* SWEET and VEUX use the built-in portable AES provider for the legacy CBC/ECB API. */
 extern const struct ccmode_cbc sweet_aes_cbc_encrypt;
 extern const struct ccmode_cbc sweet_aes_cbc_decrypt;
 #define AES_CBC_ENCRYPT_MODE (&sweet_aes_cbc_encrypt)
diff --git a/libkern/conf/Makefile.template b/libkern/conf/Makefile.template
--- a/libkern/conf/Makefile.template
+++ b/libkern/conf/Makefile.template
@@ -33,7 +33,7 @@
 corecrypto_sha1.o_CFLAGS_ADD += -mgeneral-regs-only
 endif
 
-ifeq ($(CURRENT_MACHINE_CONFIG),SWEET)
+ifneq ($(filter SWEET VEUX,$(CURRENT_MACHINE_CONFIG)),)
 SWEET_AES_ROOT = $(SRCROOT)/libkern/crypto/sweet_bearssl
 SWEET_AES_INC = -I$(SWEET_AES_ROOT)/inc -I$(SWEET_AES_ROOT)/src
 sweet_aes.o_INCFLAGS = $(SWEET_AES_INC)
diff --git a/libkern/crypto/sweet_aes.c b/libkern/crypto/sweet_aes.c
--- a/libkern/crypto/sweet_aes.c
+++ b/libkern/crypto/sweet_aes.c
@@ -4,7 +4,7 @@
  * No heap, SIMD or CPU crypto extension is needed. Contexts can be copied:
  * their only pointer is the immutable BearSSL class descriptor.
  */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_VEUX)
 #include <libkern/libkern.h>
 #include <libkern/crypto/aes.h>
 #include <corecrypto/ccmode.h>
diff --git a/libkern/crypto/sweet_aes_ct.c b/libkern/crypto/sweet_aes_ct.c
--- a/libkern/crypto/sweet_aes_ct.c
+++ b/libkern/crypto/sweet_aes_ct.c
@@ -1,4 +1,4 @@
 /* BearSSL sources are fetched at an immutable commit by 0020-stage-bearssl.sh. */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_VEUX)
 #include "sweet_bearssl/src/symcipher/aes_ct.c"
 #endif
diff --git a/libkern/crypto/sweet_aes_ct_enc.c b/libkern/crypto/sweet_aes_ct_enc.c
--- a/libkern/crypto/sweet_aes_ct_enc.c
+++ b/libkern/crypto/sweet_aes_ct_enc.c
@@ -1,4 +1,4 @@
 /* BearSSL sources are fetched at an immutable commit by 0020-stage-bearssl.sh. */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_VEUX)
 #include "sweet_bearssl/src/symcipher/aes_ct_enc.c"
 #endif
