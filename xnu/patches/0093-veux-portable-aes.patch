--- a/libkern/crypto/sweet_aes_ct_cbcenc.c
+++ b/libkern/crypto/sweet_aes_ct_cbcenc.c
@@ -1,4 +1,4 @@
 /* BearSSL sources are fetched at an immutable commit by 0020-stage-bearssl.sh. */
