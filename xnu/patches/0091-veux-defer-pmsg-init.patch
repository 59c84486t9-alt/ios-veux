From: ios-veux
Subject: [PATCH] Defer VEUX pmsg mapping until after pmap bootstrap

The kprintf startup hook runs before pmap_bootstrap, so mapping ramoops there
can recurse into an unmapped VA and panic. Keep early kprintf silent, then map
the verified pmsg range and flush buffered milestones once io_map is ready.

--- a/pexpert/arm/pe_kprintf.c
+++ b/pexpert/arm/pe_kprintf.c
@@ -71,13 +71,7 @@
 static void
 PE_init_kprintf(void)
 {
-	bool pmsg_ready = veux_pmsg_init();
-#if defined(ARM64_BOARD_CONFIG_VEUX)
-	if (pmsg_ready) {
-		veux_early_flush();
-	}
-#endif
-	if (serial_init() || pmsg_ready) {
+	if (serial_init()) {
 		PE_kputc = serial_putc_crlf;
 	} else {
 #if defined(ARM64_BOARD_CONFIG_VEUX)
@@ -94,6 +88,17 @@
 	}
 }
 STARTUP(KPRINTF, STARTUP_RANK_FIRST, PE_init_kprintf);
+
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+void
+PE_init_veux_pmsg(void)
+{
+	if (veux_pmsg_init()) {
+		veux_early_flush();
+		PE_kputc = serial_putc_crlf;
+	}
+}
+#endif
 
 #ifdef MP_DEBUG
 static void
--- a/pexpert/pexpert/arm/protos.h
+++ b/pexpert/pexpert/arm/protos.h
@@ -17,6 +17,9 @@
 #endif
 int serial_init(void);
 bool veux_pmsg_init(void);
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+void PE_init_veux_pmsg(void);
+#endif
 void veux_pmsg_putc(char c);
 
 /**
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2298,9 +2298,7 @@
 	pmap_bootstrap(dynamic_memory_begin);
 #if defined(ARM64_BOARD_CONFIG_VEUX)
 	/* pmap_bootstrap establishes the early VA allocator used by io_map(). */
-	if (veux_pmsg_init()) {
-		veux_early_flush();
-	}
+	PE_init_veux_pmsg();
 #endif
 	sweet_early_mark(13, "pmap_bootstrap done");
 
