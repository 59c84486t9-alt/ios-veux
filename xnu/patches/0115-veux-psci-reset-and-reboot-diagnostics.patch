From: ios-veux
Subject: [PATCH] Add VEUX PSCI reset and reboot-origin diagnostics
--- a/iokit/Kernel/IOPlatformExpert.cpp
+++ b/iokit/Kernel/IOPlatformExpert.cpp
@@ -52,6 +52,7 @@
 #include <libkern/c++/OSSharedPtr.h>
 #include <libkern/crypto/sha1.h>
 #include <libkern/OSAtomic.h>
+#include <pexpert/arm64/board_config.h>
 
 #if defined(__arm64__)
 #include <arm64/tlb.h>
@@ -113,6 +114,12 @@
 
 OSSymbol * gPlatformInterruptControllerName;
 
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+extern "C" void veux_lifecycle_stage(unsigned int);
+extern "C" void veux_reboot_halt_enter(uint32_t, uintptr_t *);
+extern "C" int veux_log_flush_sync(void);
+#endif
+
 /* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
 
 bool
@@ -338,6 +344,13 @@
 int
 IOPlatformExpert::haltRestart(unsigned int type)
 {
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	if (type != kPEPanicSync && type != kPEHangCPU) {
+		veux_reboot_halt_enter(type, (uintptr_t *)__builtin_frame_address(0));
+		int log_error = veux_log_flush_sync();
+		IOLog("VEUX haltRestart entry type=0x%x ring_flush=0x%x\n", type, log_error);
+	}
+#endif
 	if (type == kPEPanicSync) {
 		return 0;
 	}
@@ -353,6 +364,41 @@
 		type = kPEHaltCPU;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	if (type == kPERestartCPU || type == kPEHaltCPU ||
+	    type == kPEPanicRestartCPU || type == kPEPanicRestartCPUNoCallouts) {
+		IORegistryEntry *psci = IORegistryEntry::fromPath("/psci", gIODTPlane);
+		OSData *method = psci ? OSDynamicCast(OSData, psci->getProperty("method")) : NULL;
+		bool use_smc = method && method->getLength() == 4 &&
+		    memcmp(method->getBytesNoCopy(), "smc", 4) == 0;
+		bool use_hvc = method && method->getLength() == 4 &&
+		    memcmp(method->getBytesNoCopy(), "hvc", 4) == 0;
+		if (use_smc || use_hvc) {
+			register uint64_t x0 __asm__("x0") = (type == kPEHaltCPU) ? 0x84000008ULL : 0x84000009ULL;
+			for (unsigned int remaining = 10; remaining > 0; --remaining) {
+				IOLog("VEUX PSCI: reset in %u seconds\n", remaining);
+				IODelay(1000000);
+			}
+			int log_error = veux_log_flush_sync();
+			IOLog("VEUX PSCI: countdown complete ring_flush=0x%x\n", log_error);
+			veux_lifecycle_stage(5);
+			IOLog("VEUX PSCI: conduit=%s function=0x%llx type=0x%x before call\n",
+			    use_smc ? "smc" : "hvc", x0, type);
+			if (use_smc) {
+				__asm__ volatile("smc #0" : "+r" (x0) : : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory", "cc");
+			} else {
+				__asm__ volatile("hvc #0" : "+r" (x0) : : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory", "cc");
+			}
+			IOLog("VEUX PSCI: call returned status=0x%llx; awaiting timeout panic\n", x0);
+			(void)veux_log_flush_sync();
+			OSSafeReleaseNULL(psci);
+			return -1;
+		}
+		IOLog("VEUX PSCI: no valid /psci method; conduit unavailable\n");
+		OSSafeReleaseNULL(psci);
+	}
+#endif /* ARM64_BOARD_CONFIG_VEUX */
+
 #if defined (__x86_64__)
 	// On ARM kPEPanicRestartCPU is supported in the drivers
 	if (type == kPEPanicRestartCPU) {
--- a/osfmk/arm64/veux_early.c
+++ b/osfmk/arm64/veux_early.c
@@ -22,6 +22,11 @@
 static bool veux_early_ready;
 static bool veux_early_overflow;
 static bool veux_early_panicking;
+static uint32_t veux_reboot_howto, veux_reboot_pid, veux_reboot_type, veux_reboot_seen;
+static char veux_reboot_name[32];
+static uintptr_t veux_reboot_frames[8];
+static unsigned int veux_reboot_frame_count;
+void veux_lifecycle_stage(unsigned int stage);
 
 static void
 veux_early_putc(char c)
@@ -83,11 +88,27 @@
 	veux_fb_panic_putc('\n');
 	const char *label = "caller=0x"; while (*label) veux_fb_panic_putc(*label++);
 	veux_panic_hex((uint64_t)caller); veux_fb_panic_putc('\n');
-	thread_t thread = current_thread();
-	uintptr_t low = thread ? (uintptr_t)thread->kernel_stack : 0;
-	uintptr_t high = low + kernel_stack_size;
-	uintptr_t *frame = (uintptr_t *)__builtin_frame_address(0);
-	for (unsigned int i = 0; i < 8; ++i) {
+	if (veux_reboot_seen) {
+		const char *howto = "reboot howto=0x"; while (*howto) veux_fb_panic_putc(*howto++);
+		veux_panic_hex(veux_reboot_howto); veux_fb_panic_putc('\n');
+		const char *pe_type = "haltRestart type=0x"; while (*pe_type) veux_fb_panic_putc(*pe_type++);
+		veux_panic_hex(veux_reboot_type); veux_fb_panic_putc('\n');
+		const char *requester = "requester="; while (*requester) veux_fb_panic_putc(*requester++);
+		for (unsigned int i = 0; i < sizeof(veux_reboot_name) && veux_reboot_name[i]; ++i) veux_fb_panic_putc(veux_reboot_name[i]);
+		veux_fb_panic_putc(' ');
+		const char *pid = "pid=0x"; while (*pid) veux_fb_panic_putc(*pid++);
+		veux_panic_hex(veux_reboot_pid); veux_fb_panic_putc('\n');
+		for (unsigned int i = 0; i < veux_reboot_frame_count; ++i) {
+			veux_fb_panic_putc('r'); veux_fb_panic_putc('e'); veux_fb_panic_putc('q');
+			veux_fb_panic_putc('0' + i); veux_fb_panic_putc('='); veux_fb_panic_putc('0'); veux_fb_panic_putc('x');
+			veux_panic_hex(veux_reboot_frames[i]); veux_fb_panic_putc('\n');
+		}
+	} else {
+		thread_t thread = current_thread();
+		uintptr_t low = thread ? (uintptr_t)thread->kernel_stack : 0;
+		uintptr_t high = low + kernel_stack_size;
+		uintptr_t *frame = (uintptr_t *)__builtin_frame_address(0);
+		for (unsigned int i = 0; i < 8; ++i) {
 		char prefix[8] = {'f','r','a','m','e','0','=',0};
 		prefix[5] = (char)('0' + i);
 		for (unsigned int j = 0; prefix[j]; ++j) veux_fb_panic_putc(prefix[j]);
@@ -99,11 +120,61 @@
 		veux_panic_hex(ret); veux_fb_panic_putc('\n');
 		if (next <= (uintptr_t)frame || next >= high || next - (uintptr_t)frame > kernel_stack_size) break;
 		frame = (uintptr_t *)next;
+		}
 	}
 	veux_fb_panic_console_tail();
 	veux_stage_flush();
+	extern int veux_log_flush_sync(void);
+	(void)veux_log_flush_sync();
 }
 
+void
+veux_reboot_request(uint32_t howto, const char *name, int pid, uintptr_t *frame)
+{
+	thread_t thread = current_thread();
+	uintptr_t low = thread ? (uintptr_t)thread->kernel_stack : 0;
+	uintptr_t high = low + kernel_stack_size;
+	veux_reboot_howto = howto;
+	veux_reboot_pid = (uint32_t)pid;
+	veux_reboot_seen = 1;
+	unsigned int i = 0;
+	while (i + 1 < sizeof(veux_reboot_name) && name && name[i]) {
+		veux_reboot_name[i] = name[i];
+		i++;
+	}
+	veux_reboot_name[i] = '\0';
+	veux_reboot_frame_count = 0;
+	while (frame && veux_reboot_frame_count < 8 && (uintptr_t)frame >= low &&
+	    (uintptr_t)frame <= high - 2 * sizeof(uintptr_t) && ((uintptr_t)frame & 15) == 0) {
+		uintptr_t next = frame[0];
+		uintptr_t ret = frame[1];
+		if (!ret) break;
+		veux_reboot_frames[veux_reboot_frame_count++] = ret;
+		if (next <= (uintptr_t)frame || next >= high || next - (uintptr_t)frame > kernel_stack_size) break;
+		frame = (uintptr_t *)next;
+	}
+	veux_lifecycle_stage(4);
+}
+
+void
+veux_reboot_halt_enter(uint32_t type, uintptr_t *frame)
+{
+	thread_t thread = current_thread();
+	uintptr_t low = thread ? (uintptr_t)thread->kernel_stack : 0;
+	uintptr_t high = low + kernel_stack_size;
+	veux_reboot_type = type;
+	veux_reboot_frame_count = 0;
+	while (frame && veux_reboot_frame_count < 8 && (uintptr_t)frame >= low &&
+	    (uintptr_t)frame <= high - 2 * sizeof(uintptr_t) && ((uintptr_t)frame & 15) == 0) {
+		uintptr_t next = frame[0];
+		uintptr_t ret = frame[1];
+		if (!ret) break;
+		veux_reboot_frames[veux_reboot_frame_count++] = ret;
+		if (next <= (uintptr_t)frame || next >= high || next - (uintptr_t)frame > kernel_stack_size) break;
+		frame = (uintptr_t *)next;
+	}
+}
+
 /* Low splash RAM is outside the high-bank physmap. start.s provides a
  * narrow identity alias; arm_vm_init switches us to a permanent kernel VA. */
 uint32_t veux_exception_seen;
@@ -790,6 +859,18 @@
  for (unsigned y=y0;y<y0+32;++y)
   for (unsigned x=32+64*cell;x<64+64*cell;++x) fb[y*1080+x]=colors[stage];
  veux_stage_flush();
+}
+
+void
+veux_lifecycle_stage(unsigned int stage)
+{
+	static const uint32_t colors[6] = {0xffffffff, 0xffff8000, 0xffff00ff, 0xffff0000, 0xff00ffff, 0xff40ff40};
+	if (stage >= 6) return;
+	volatile uint32_t *fb = (volatile uint32_t *)veux_stage_fb;
+	for (unsigned y = 2240; y < 2272; ++y)
+		for (unsigned x = 32 + 64 * stage; x < 64 + 64 * stage; ++x)
+			fb[y * 1080 + x] = colors[stage];
+	veux_stage_flush();
 }
 
 #endif /* ARM64_BOARD_CONFIG_VEUX */
--- a/bsd/kern/kern_shutdown.c
+++ b/bsd/kern/kern_shutdown.c
@@ -178,6 +178,27 @@
 {
 	int hostboot_option = 0;
 	uint64_t startTime;
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	{
+		extern void veux_reboot_request(uint32_t, const char *, int, uintptr_t *);
+		extern void veux_lifecycle_stage(unsigned int);
+		extern int veux_log_flush_sync(void);
+		proc_t requestor = current_proc();
+		veux_reboot_request((uint32_t)howto, requestor ? requestor->p_comm : "kernel",
+		    requestor ? requestor->p_pid : 0, (uintptr_t *)__builtin_frame_address(0));
+		veux_lifecycle_stage(4);
+		printf("VEUX reboot requested howto=0x%x caller=%s pid=0x%x message=\"%s\" message_hex=",
+		    howto, requestor ? requestor->p_comm : "kernel", requestor ? requestor->p_pid : 0,
+		    message ? message : "<none>");
+		if (message) {
+			for (unsigned int i = 0; i < 1024 && message[i] != '\0'; ++i) printf("%02x", (unsigned char)message[i]);
+		}
+		printf("\n");
+		int log_error = veux_log_flush_sync();
+		printf("VEUX reboot request ring_flush=0x%x\n", log_error);
+		(void)veux_log_flush_sync();
+	}
+#endif
 
 	if ((howto & (RB_PANIC | RB_QUICK)) == (RB_PANIC | RB_QUICK)) {
 		panic_kernel(howto, message);
