From: ios-veux
Subject: [PATCH] Trigger delayed GPI summaries from the probe hook

The liveness console marker is not present on this boot path. Start the
read-only summary worker directly from the preflight hook so the captured
state is reprinted after boot logging advances.

diff --git a/bsd/dev/veux_gpi_preflight.c b/bsd/dev/veux_gpi_preflight.c
--- a/bsd/dev/veux_gpi_preflight.c
+++ b/bsd/dev/veux_gpi_preflight.c
@@ -4,9 +4,14 @@
 #include <sys/systm.h>
 #include <pexpert/pexpert.h>
 #include <machine/machine_routines.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void veux_fb_print_build_id(void);
+extern int hz;
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
 
 #define VEUX_GPI_PA       0x04c00000u
 #define VEUX_GPI_MAP_SIZE 0x00060000u
@@ -37,6 +42,11 @@
 static uint32_t gpi_summary_scr0, gpi_summary_gbpa, gpi_summary_sid_supported;
 static uint32_t gpi_summary_matches, gpi_summary_ch0_cfg, gpi_summary_ch1_cfg;
 static uint32_t gpi_summary_ev0_cfg;
+static int gpi_summary_sleep_chan;
+static unsigned gpi_summary_thread_started;
+static void gpi_summary_thread(void *, wait_result_t);
+static void veux_gpi_schedule_summary(void);
+void veux_gpi_preflight_report(void);
 
 static uint32_t
 gpi_preflight_read(vm_offset_t base, uint32_t off)
@@ -77,6 +87,7 @@
 	gpi_summary_map_smmu = smmu != 0;
 	if (!gpi || !smmu) {
 		gpi_summary_complete = 1;
+		veux_gpi_schedule_summary();
 		printf("VEUX GPI PREFLIGHT: map failed gpi=%u smmu=%u; read-only, no DMA attempted\n",
 		    gpi != 0, smmu != 0);
 		veux_fb_print_build_id();
@@ -142,7 +153,36 @@
 	gpi_summary_ch1_cfg = gpi_preflight_read(gpi, GPI_CH_CTX(1) - VEUX_GPI_EE_OFFSET);
 	gpi_summary_ev0_cfg = gpi_preflight_read(gpi, ev_off);
 	gpi_summary_complete = 1;
+	veux_gpi_schedule_summary();
 	veux_fb_print_build_id();
+}
+
+static void
+gpi_summary_thread(void *__unused arg, __unused wait_result_t wr)
+{
+	for (unsigned i = 0; i < 3; ++i) {
+		(void)tsleep(&gpi_summary_sleep_chan, PZERO, "veuxgpi", i == 0 ? 2 * hz : 10 * hz);
+		veux_gpi_preflight_report();
+	}
+}
+
+static void
+veux_gpi_schedule_summary(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (!PE_parse_boot_argn("veuxgpipreflight", &enabled, sizeof(enabled)) || enabled != 1 ||
+	    gpi_summary_thread_started) {
+		return;
+	}
+	gpi_summary_thread_started = 1;
+	if (kernel_thread_start(gpi_summary_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("VEUX GPI SUMMARY THREAD: started; three delayed read-only reports\n");
+	} else {
+		gpi_summary_thread_started = 0;
+		printf("VEUX GPI SUMMARY THREAD: start failed\n");
+	}
 }
 
 void
