From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Register the software AppleKeyStore on VEUX

The VEUX target has no SEP. SpringBoard's MobileKeyBag initialization
requires an AppleKeyStore service for event registration, so make the
existing no-passcode software implementation available on VEUX.

--- a/iokit/KernelConfigTables.cpp
+++ b/iokit/KernelConfigTables.cpp
@@ -44,7 +44,12 @@
     "   {"
     "     'IOClass'         = VeuxCPU;"
     "     'IOProviderClass' = IOPlatformDevice;"
     "     'IONameMatch'     = 'qcom,kryo';"
     "     'IOProbeScore'    = 10000:32;"
     "   },"
+    "   {"
+    "     'IOClass'         = AppleKeyStore;"
+    "     'IOProviderClass' = IOResources;"
+    "     'IOMatchCategory' = AppleKeyStore;"
+    "   },"
     /* Startup of these compatibility services requires veux_gui=1. */
--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -19,2 +19,2 @@
-#if defined(SWEET)
+#if defined(SWEET) || defined(ARM64_BOARD_CONFIG_VEUX)
 #include <IOKit/IOService.h>
