From: ios-veux
Subject: [PATCH] Sample VEUX process liveness after launchd early boot

After launchd reports early boot complete, periodically print a bounded
process/thread snapshot to the framebuffer console. Console output is mirrored
into the in-memory ring, but this sampler does not flush storage.

diff --git a/bsd/conf/files b/bsd/conf/files
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -110,2 +110,3 @@
 bsd/dev/sweet_sample.c			standard
+bsd/dev/veux_liveness.c			standard
 bsd/dev/sweet_keys.c			standard

diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -540,6 +540,17 @@
 	static const char marker[] = "VEUX_FB_GREEN_BLOCK\n";
 	static unsigned marker_pos;
+	static const char boot_done[] = "Early boot complete. Continuing system boot.";
+	static unsigned boot_done_pos;
+	extern void veux_liveness_start(void);
 	for (int n = 0; n < size; n++) {
 		char c = str[n];
+		if (c == boot_done[boot_done_pos]) {
+			if (++boot_done_pos == sizeof(boot_done) - 1) {
+				veux_liveness_start();
+				boot_done_pos = 0;
+			}
+		} else {
+			boot_done_pos = (c == boot_done[0]) ? 1 : 0;
+		}
 		if (c == marker[marker_pos]) {
 			marker_pos++;
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -76,5 +76,6 @@
 static char veux_log_ring[VEUX_LOG_SIZE];
 static uint64_t _Atomic veux_log_total;
 static uint32_t _Atomic veux_log_lock;
+static uint32_t _Atomic veux_log_build_id_written;
 static int veux_log_chan;
 static bool veux_log_started;
@@ -83,6 +84,19 @@
 veux_log_append(const char *c, int size)
 {
 	if (size <= 0) {
 		return;
 	}
+	/* The first persistent-ring line identifies the exact kernel build. */
+	if (os_atomic_load(&veux_log_build_id_written, relaxed) == 0) {
+		if (!os_atomic_cmpxchg(&veux_log_lock, 0, 1, acquire)) return;
+		if (os_atomic_cmpxchg(&veux_log_build_id_written, 0, 1, relaxed)) {
+			static const char build_id_line[] = "VEUX BUILD: ID=__VEUX_BUILD_ID__\n";
+			for (unsigned int i = 0; i < sizeof(build_id_line) - 1; ++i) {
+				uint64_t at = os_atomic_load(&veux_log_total, relaxed);
+				veux_log_ring[at % VEUX_LOG_SIZE] = build_id_line[i];
+				os_atomic_store(&veux_log_total, at + 1, release);
+			}
+		}
+		os_atomic_store(&veux_log_lock, 0, release);
+	}
 	/* Console output may arrive in panic or interrupt context. Drop a byte
diff --git a/osfmk/arm64/veux_early.c b/osfmk/arm64/veux_early.c
--- a/osfmk/arm64/veux_early.c
+++ b/osfmk/arm64/veux_early.c
@@ -851,3 +851,15 @@
 }
+void
+veux_idle_sample_report(void)
+{
+ static bool have_previous;
+ static uint64_t previous_runq, previous_rt;
+ if (!have_previous || previous_runq != vw_runq || previous_rt != vw_rt) {
+     printf("VEUX IDLE: pset_runq=%llu rt_runq=%llu\n", vw_runq, vw_rt);
+     previous_runq = vw_runq;
+     previous_rt = vw_rt;
+     have_previous = true;
+ }
+}
 void
 veux_bsd_stage(unsigned int stage)
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -79,4 +79,5 @@
 #include <kern/ipc_tt.h>
 #include <kern/task.h>
 #include <kern/thread.h>
+#include <kern/waitq.h>
 #include <kern/processor.h>
@@ -1049,3 +1050,81 @@
 #endif /* ARM64_BOARD_CONFIG_SWEET */
-
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+/* Keep BSD process enumeration separate from private Mach thread state. */
+struct veux_wait_record { uint64_t tid, event, pc; uint32_t state, hint, waitq; };
+static void
+veux_live_launchd_vm(task_t task, uint64_t pc)
+{
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr != NULL) {
+		printf("VEUX VM: launchd shared_base=0x%llx first=0x%llx slide=0x%x size=0x%llx\n",
+		    (unsigned long long)sr->sr_base_address,
+		    (unsigned long long)sr->sr_first_mapping, sr->sr_slide,
+		    (unsigned long long)sr->sr_size);
+		vm_shared_region_deallocate(sr);
+	} else {
+		printf("VEUX VM: launchd shared_region=none\n");
+	}
+	vm_map_t map = get_task_map_reference(task);
+	if (map == VM_MAP_NULL) return;
+	vm_map_entry_t entry;
+	vm_map_lock_read(map);
+	if (vm_map_lookup_entry(map, (vm_map_offset_t)pc, &entry)) {
+		printf("VEUX VM: launchd pc=0x%llx region=0x%llx-0x%llx prot=%d/%d tag=%d\n",
+		    (unsigned long long)pc, (unsigned long long)entry->vme_start,
+		    (unsigned long long)entry->vme_end, entry->protection,
+		    entry->max_protection, (int)VME_ALIAS(entry));
+	} else {
+		printf("VEUX VM: launchd pc=0x%llx region=not-found\n", (unsigned long long)pc);
+	}
+	vm_map_unlock_read(map);
+	vm_map_deallocate(map);
+}
+void
+veux_live_task_snapshot(task_t task, int *thread_count, uint64_t *user_pc, bool launchd)
+{
+	static bool previous_launchd_wait_valid;
+	static uint64_t previous_launchd_wait_hash;
+	thread_t thread;
+	struct veux_wait_record waits[64];
+	int count = 0, saved = 0;
+	uint64_t pc = 0, wait_hash = 1469598103934665603ULL;
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		thread_lock(thread);
+		arm_saved_state_t *ss = find_user_regs(thread);
+		uint64_t thread_pc = ss != NULL && is_saved_state64(ss) ? get_saved_state_pc(ss) : 0;
+		/* Runnable threads may have no wait queue; waitq_type dereferences it. */
+		uint32_t kind = thread->waitq.wq_q != NULL ?
+		    (uint32_t)waitq_type(thread->waitq) : 0;
+		count++;
+		if (pc == 0 && thread_pc != 0) pc = thread_pc;
+		if (launchd) {
+			uint64_t tid = thread_tid(thread), event = (uint64_t)thread->wait_event;
+			uint32_t state = thread->state, hint = thread->block_hint;
+			wait_hash = (wait_hash ^ tid) * 1099511628211ULL;
+			wait_hash = (wait_hash ^ event) * 1099511628211ULL;
+			wait_hash = (wait_hash ^ (((uint64_t)state << 32) | ((uint64_t)hint << 16) | kind)) * 1099511628211ULL;
+			if (saved < (int)(sizeof(waits) / sizeof(waits[0]))) {
+				waits[saved++] = (struct veux_wait_record){ tid, event, thread_pc, state, hint, kind };
+			}
+		}
+		thread_unlock(thread);
+	}
+	task_unlock(task);
+	if (launchd && (!previous_launchd_wait_valid || previous_launchd_wait_hash != wait_hash)) {
+		printf("VEUX WAIT: launchd threads=%d waitq_kind: 1=queue 2=turnstile 3=port 4=select 5=port_set 6=select_set\n", count);
+		for (int i = 0; i < saved; i++) {
+			printf("VEUX WAIT: tid=%llu state=0x%x event=0x%llx hint=0x%x waitq=%u pc=0x%llx\n",
+			    (unsigned long long)waits[i].tid, waits[i].state,
+			    (unsigned long long)waits[i].event, waits[i].hint, waits[i].waitq,
+			    (unsigned long long)waits[i].pc);
+		}
+		veux_live_launchd_vm(task, pc);
+		previous_launchd_wait_hash = wait_hash;
+		previous_launchd_wait_valid = true;
+	}
+	if (thread_count != NULL) *thread_count = count;
+	if (user_pc != NULL) *user_pc = pc;
+}
+#endif
 kern_return_t
diff --git a/bsd/dev/veux_liveness.c b/bsd/dev/veux_liveness.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/veux_liveness.c
@@ -0,0 +1,165 @@
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+/* Keep process metadata in BSD; Mach thread state comes from OSFMK. */
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <sys/resourcevar.h>
+#include <os/atomic_private.h>
+#include <pexpert/pexpert.h>
+
+extern int hz;
+extern void veux_idle_sample_report(void);
+extern void veux_live_task_snapshot(task_t, int *, uint64_t *, bool);
+void veux_liveness_start(void);
+
+#define VEUX_LIVE_MAX 16
+#define VEUX_SEEN_MAX 1024
+struct veux_live_entry {
+	int pid, ppid, state, threads;
+	uint64_t user_us, system_us, user_delta_us, system_delta_us, user_pc;
+	char name[32];
+};
+static struct veux_live_entry live_entries[VEUX_LIVE_MAX], previous_entries[VEUX_LIVE_MAX];
+static unsigned int live_count, previous_live_count, process_count, thread_count;
+static unsigned int previous_process_count, previous_thread_count;
+static bool live_have_snapshot;
+static int live_pids[VEUX_SEEN_MAX], previous_pids[VEUX_SEEN_MAX];
+static unsigned int live_pid_count, previous_pid_count;
+static int live_chan;
+static unsigned int live_started;
+
+static bool
+veux_pid_seen(int pid)
+{
+	for (unsigned int i = 0; i < previous_pid_count; i++) {
+		if (previous_pids[i] == pid) {
+			if (live_pid_count < VEUX_SEEN_MAX) live_pids[live_pid_count++] = pid;
+			return true;
+		}
+	}
+	if (live_pid_count < VEUX_SEEN_MAX) live_pids[live_pid_count++] = pid;
+	return false;
+}
+
+static void
+veux_previous_cpu(int pid, uint64_t *user, uint64_t *system)
+{
+	*user = *system = 0;
+	for (unsigned int i = 0; i < previous_live_count; i++) {
+		if (previous_entries[i].pid == pid) {
+			*user = previous_entries[i].user_us;
+			*system = previous_entries[i].system_us;
+			return;
+		}
+	}
+}
+
+static int
+veux_live_proc(proc_t p, __unused void *arg)
+{
+	int pid = proc_pid(p);
+	task_t task = proc_task(p);
+	int nthreads = 0;
+	uint64_t user_pc = 0;
+	if (task != TASK_NULL) {
+		veux_live_task_snapshot(task, &nthreads, &user_pc, false);
+	}
+	process_count++;
+	thread_count += nthreads;
+	if (live_count < VEUX_LIVE_MAX) {
+		struct veux_live_entry *e = &live_entries[live_count++];
+		e->pid = pid;
+		e->ppid = p->p_pptr ? proc_pid(p->p_pptr) : 0;
+		e->state = p->p_stat;
+		e->threads = nthreads;
+		e->user_us = p->p_stats ? (uint64_t)p->p_stats->p_ru.ru_utime.tv_sec * 1000000ULL + p->p_stats->p_ru.ru_utime.tv_usec : 0;
+		e->system_us = p->p_stats ? (uint64_t)p->p_stats->p_ru.ru_stime.tv_sec * 1000000ULL + p->p_stats->p_ru.ru_stime.tv_usec : 0;
+		e->user_pc = user_pc;
+		proc_name(pid, e->name, sizeof(e->name));
+	}
+	return PROC_RETURNED;
+}
+
+static void
+veux_live_launchd(void)
+{
+	proc_t p = proc_find(1);
+	task_t task = p ? proc_task(p) : TASK_NULL;
+	if (task == TASK_NULL) {
+		if (p) proc_rele(p);
+		printf("VEUX LIVE: launchd task unavailable\n");
+		return;
+	}
+	veux_live_task_snapshot(task, NULL, NULL, true);
+	proc_rele(p);
+}
+
+static void
+veux_liveness_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		previous_process_count = process_count;
+		previous_thread_count = thread_count;
+		memcpy(previous_pids, live_pids, live_pid_count * sizeof(live_pids[0]));
+		previous_pid_count = live_pid_count;
+		memcpy(previous_entries, live_entries, live_count * sizeof(live_entries[0]));
+		previous_live_count = live_count;
+		live_pid_count = 0;
+		live_count = process_count = thread_count = 0;
+		proc_iterate(PROC_ALLPROCLIST, veux_live_proc, NULL, NULL, NULL);
+		bool changed = !live_have_snapshot || process_count != previous_process_count ||
+		    thread_count != previous_thread_count;
+		for (unsigned int i = 0; !changed && i < live_count; i++) {
+			struct veux_live_entry *e = &live_entries[i];
+			bool found = false;
+			for (unsigned int j = 0; j < previous_live_count; j++) {
+				struct veux_live_entry *old = &previous_entries[j];
+				if (old->pid == e->pid) {
+					found = true;
+					if (old->ppid != e->ppid || old->state != e->state ||
+					    old->threads != e->threads ||
+					    strncmp(old->name, e->name, sizeof(e->name)) != 0) changed = true;
+					break;
+				}
+			}
+			if (!found) changed = true;
+		}
+		veux_idle_sample_report();
+		if (changed) {
+			printf("VEUX LIVE: processes=%u threads=%u\n", process_count, thread_count);
+		for (unsigned int i = 0; i < live_count; i++) {
+			struct veux_live_entry *e = &live_entries[i];
+			const char *mark = e->pid == 1 ? "launchd" : (e->ppid == 1 ? "child" : "");
+			uint64_t old_user, old_system;
+			veux_previous_cpu(e->pid, &old_user, &old_system);
+			bool is_new = !veux_pid_seen(e->pid);
+			e->user_delta_us = e->user_us >= old_user ? e->user_us - old_user : 0;
+			e->system_delta_us = e->system_us >= old_system ? e->system_us - old_system : 0;
+			printf("VEUX LIVE: pid=%d ppid=%d name=%s state=%d cpu_us=%llu/%llu delta_us=%llu/%llu threads=%d user_pc=0x%llx %s%s\n",
+			    e->pid, e->ppid, e->name, e->state,
+			    (unsigned long long)e->user_us, (unsigned long long)e->system_us,
+			    (unsigned long long)e->user_delta_us, (unsigned long long)e->system_delta_us,
+			    e->threads, (unsigned long long)e->user_pc, mark, is_new ? " NEW" : "");
+		}
+			live_have_snapshot = true;
+		} else {
+			for (unsigned int i = 0; i < live_count; i++) (void)veux_pid_seen(live_entries[i].pid);
+		}
+		veux_live_launchd();
+		(void)tsleep(&live_chan, PWAIT, "veuxlive", 10 * hz);
+	}
+}
+
+void
+veux_liveness_start(void)
+{
+	thread_t thread;
+	if (!os_atomic_cmpxchg(&live_started, 0, 1, relaxed)) return;
+	printf("VEUX BUILD: ID=__VEUX_BUILD_ID__\n");
+	if (kernel_thread_start(veux_liveness_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		os_atomic_store(&live_started, 0, relaxed);
+	}
+}
