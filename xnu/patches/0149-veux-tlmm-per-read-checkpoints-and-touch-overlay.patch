From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Checkpoint per-pin VEUX TLMM reads and fix touch overlay

Compare the two candidate TLMM windows one 32-bit CFG read at a time. Flush
an on-screen counter and GPIO number before each access, skip GPIO0-3, and
retain BEFORE/AFTER physical and virtual addresses. No GPIO or UFS writes are
performed by the held probe. Move the touch status panel away from the clock,
clear it at the first GUI present, and label the hexadecimal diagnostics.

--- a/bsd/dev/veux_touch_probe.c
+++ b/bsd/dev/veux_touch_probe.c
@@ -7,6 +7,7 @@
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void veux_fb_print_build_id(void);
+extern void veux_fb_touch_probe_checkpoint(unsigned int, unsigned int, bool);
 
 #define VEUX_TOUCH_TLMM_PA     0x00400000u
 #define VEUX_TOUCH_TLMM_ALT_PA 0x00500000u
@@ -76,23 +77,22 @@
 }
 
 static uint32_t
-touch_probe_tlmm_cfg_once(vm_offset_t va, vm_offset_t pa, unsigned pin)
+touch_probe_tlmm_cfg_once(vm_offset_t va, vm_offset_t pa, unsigned pin, unsigned seq)
 {
 	uint32_t off = TLMM_GPIO_CFG(pin);
 	vm_offset_t addr = va + (vm_offset_t)off;
 	vm_offset_t phys = pa + (vm_offset_t)off;
-	printf("VEUX TLMM BEFORE pin=%u CFG PA=%#llx VA=%p width=32\n",
-	    pin, (unsigned long long)phys, (void *)addr);
-	__asm__ volatile("dmb ish" ::: "memory");
+	printf("VEUX TLMM BEFORE #%u pin=%u CFG PA=%#llx VA=%p width=32\n",
+	    seq, pin, (unsigned long long)phys, (void *)addr);
+	/* Draw and flush the checkpoint before touching this MMIO address. */
+	veux_fb_touch_probe_checkpoint(seq, pin,
+	    pa == VEUX_TOUCH_TLMM_ALT_PA);
 	touch_probe_read_pin = pin;
 	touch_probe_read_pa = phys;
 	touch_probe_read_va = addr;
 	touch_probe_read_armed = true;
-	__asm__ volatile("dmb ish" ::: "memory");
 	uint32_t value = *(volatile uint32_t *)addr;
-	__asm__ volatile("dmb oshld" ::: "memory");
 	touch_probe_read_armed = false;
-	__asm__ volatile("dmb ish" ::: "memory");
 	printf("VEUX TLMM AFTER pin=%u CFG PA=%#llx VA=%p value=%08x\n",
 	    pin, (unsigned long long)phys, (void *)addr, value);
 	return value;
@@ -113,19 +113,39 @@
 
 	printf("VEUX BOOT: variant=held\n");
 	veux_fb_print_build_id();
-	printf("VEUX TLMM TARGETS: REG_BASE candidate=0x500000; read GPIO3 control then GPIO19 SDA only\n");
-	vm_offset_t tlmm = ml_io_map(VEUX_TOUCH_TLMM_ALT_PA, VEUX_TOUCH_TLMM_SIZE);
-	if (!tlmm) {
-		printf("VEUX TLMM MAP FAILED PA=%#llx size=%#x\n",
-		    (unsigned long long)VEUX_TOUCH_TLMM_ALT_PA, VEUX_TOUCH_TLMM_SIZE);
+	printf("VEUX TLMM TARGETS: compare PA 0x500000 and 0x400000; skip GPIO0-3\n");
+	printf("VEUX TLMM RESERVATIONS: no reserved/TZ GPIO ranges found in downstream DT; chardev consumers are ownership only\n");
+	vm_offset_t alt = ml_io_map(VEUX_TOUCH_TLMM_ALT_PA, VEUX_TOUCH_TLMM_SIZE);
+	vm_offset_t primary = ml_io_map(VEUX_TOUCH_TLMM_PA, VEUX_TOUCH_TLMM_SIZE);
+	if (!alt || !primary) {
+		printf("VEUX TLMM MAP FAILED alt=%u primary=%u\n", alt != 0, primary != 0);
 		return;
 	}
-	printf("VEUX TLMM MAP PA=%#llx VA=%p bytes=%#x attr=VM_WIMG_IO\n",
-	    (unsigned long long)VEUX_TOUCH_TLMM_ALT_PA, (void *)tlmm,
-	    VEUX_TOUCH_TLMM_SIZE);
-	(void)touch_probe_tlmm_cfg_once(tlmm, VEUX_TOUCH_TLMM_ALT_PA, 3);
-	(void)touch_probe_tlmm_cfg_once(tlmm, VEUX_TOUCH_TLMM_ALT_PA, 19);
-	printf("VEUX TOUCH PROBE: held before root mount; exactly two read-only TLMM CFG reads; no UFS/GPIO writes\n");
+	printf("VEUX TLMM MAP ALT PA=%#llx VA=%p bytes=%#x attr=VM_WIMG_IO\n",
+	    (unsigned long long)VEUX_TOUCH_TLMM_ALT_PA, (void *)alt, VEUX_TOUCH_TLMM_SIZE);
+	printf("VEUX TLMM MAP PRIMARY PA=%#llx VA=%p bytes=%#x attr=VM_WIMG_IO\n",
+	    (unsigned long long)VEUX_TOUCH_TLMM_PA, (void *)primary, VEUX_TOUCH_TLMM_SIZE);
+	static const unsigned touch_pins[] = {19, 20, 21, 22, 44, 51};
+	unsigned seq = 0;
+	for (unsigned i = 0; i < sizeof(touch_pins) / sizeof(touch_pins[0]); ++i) {
+		unsigned pin = touch_pins[i];
+		seq++;
+		(void)touch_probe_tlmm_cfg_once(alt, VEUX_TOUCH_TLMM_ALT_PA, pin, seq);
+		seq++;
+		(void)touch_probe_tlmm_cfg_once(primary, VEUX_TOUCH_TLMM_PA, pin, seq);
+	}
+	/* With GPIO0-3 explicitly skipped, read each remaining CFG independently. */
+	for (unsigned pin = 4; pin < 64; ++pin) {
+		bool already_read = false;
+		for (unsigned i = 0; i < sizeof(touch_pins) / sizeof(touch_pins[0]); ++i)
+			if (pin == touch_pins[i]) already_read = true;
+		if (already_read) continue;
+		seq++;
+		(void)touch_probe_tlmm_cfg_once(alt, VEUX_TOUCH_TLMM_ALT_PA, pin, seq);
+		seq++;
+		(void)touch_probe_tlmm_cfg_once(primary, VEUX_TOUCH_TLMM_PA, pin, seq);
+	}
+	printf("VEUX TOUCH PROBE: held before root mount; read-only per-pin CFG comparison complete; GPIO0-3 skipped; no UFS/GPIO writes\n");
 	veux_fb_print_build_id();
 	for (;;) __asm__ volatile("wfe" ::: "memory");
 }
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -1723,13 +1723,13 @@
 	    state == 10 ? "TOUCH: SE8 setup FAILED" :
 	    state == 11 ? "TOUCH: report read FAILED err=" :
 	    state == 13 ? "TOUCH: GT9896 report polling" :
-	    state == 14 ? "TOUCH: unsupported/no unique IC flags=" :
-	    state == 15 ? "TOUCH: I2C IRQ bits" :
-	    state == 16 ? "TOUCH: SE/tx/rx" :
+	    state == 14 ? "TOUCH: unsupported IC flags=" :
+	    state == 15 ? "TOUCH: I2C IRQ bits=" :
+	    state == 16 ? "TOUCH: SE/TX/RX=" :
 	    "TOUCH: unknown state";
 	volatile uint32_t *fb = veux_fb_console_base;
 	const uint32_t stride = veux_fb_console_stride / 4u;
-	const uint32_t x0 = 12, y0 = 160u + row * 32u, pad = 6;
+	const uint32_t x0 = 12, y0 = VEUX_FB_HEIGHT - 300u + row * 32u, pad = 6;
 	uint32_t msg_len = 0;
 	while (message[msg_len]) ++msg_len;
 	const uint32_t width = (msg_len + 10u) * 8u + pad * 2u;
@@ -1787,4 +1787,51 @@
 	}
 }
 
+void
+veux_fb_touch_status_clear(void)
+{
+	if (!veux_fb_console_base) return;
+	volatile uint32_t *fb = veux_fb_console_base;
+	const uint32_t stride = veux_fb_console_stride / 4u;
+	const uint32_t y0 = VEUX_FB_HEIGHT - 300u;
+	for (uint32_t y = y0; y < VEUX_FB_HEIGHT - 120u; ++y)
+		for (uint32_t x = 0; x < VEUX_FB_WIDTH; ++x) fb[y * stride + x] = 0xff000000u;
+	for (unsigned int row = 0; row < VEUX_TOUCH_STATUS_HISTORY; ++row)
+		veux_fb_touch_state[row] = 0xffffffffu;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+veux_fb_touch_draw_char(unsigned char c, uint32_t x0, uint32_t y0, uint32_t stride)
+{
+	for (unsigned y = 0; y < 16; ++y) {
+		unsigned char bits = iso_font[(unsigned)c * 16u + y];
+		for (unsigned b = 0; b < 8; ++b) if (bits & (0x80u >> b))
+			veux_fb_console_base[(y0 + y) * stride + x0 + b] = 0xffffffffu;
+	}
+}
+
+void
+veux_fb_touch_probe_checkpoint(unsigned int seq, unsigned int pin, bool alt)
+{
+	if (!veux_fb_console_base || !veux_fb_console_ready) return;
+	volatile uint32_t *fb = veux_fb_console_base;
+	const uint32_t stride = veux_fb_console_stride / 4u;
+	const uint32_t x0 = 12u, y0 = VEUX_FB_HEIGHT - 40u, width = 280u;
+	for (uint32_t y = y0; y < y0 + 24u; ++y)
+		for (uint32_t x = x0; x < x0 + width; ++x) fb[y * stride + x] = 0xff000000u;
+	static const char prefix[] = "TLMM 500000 A #000 GPIO00";
+	char line[sizeof(prefix)];
+	for (unsigned i = 0; i < sizeof(prefix); ++i) line[i] = prefix[i];
+	line[12] = alt ? 'A' : 'P';
+	line[15] = '0' + ((seq / 100u) % 10u);
+	line[16] = '0' + ((seq / 10u) % 10u);
+	line[17] = '0' + (seq % 10u);
+	line[23] = '0' + ((pin / 10u) % 10u);
+	line[24] = '0' + (pin % 10u);
+	for (unsigned i = 0; line[i]; ++i) veux_fb_touch_draw_char((unsigned char)line[i], x0 + 4u + i * 8u, y0 + 4u, stride);
+	/* Complete the framebuffer writes before the following MMIO read. */
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
 #endif /* ARM64_BOARD_CONFIG_VEUX */
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -40,6 +40,7 @@
 extern "C" void veux_fb_normal_status_draw(void);
 extern "C" void veux_fb_normal_status_clear(void);
 extern "C" void veux_fb_touch_status_redraw(void);
+extern "C" void veux_fb_touch_status_clear(void);
 extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
 
 #if defined(SWEET) || defined(ARM64_BOARD_CONFIG_VEUX)
@@ -564,12 +565,12 @@
 				veux_gui_first_present = 1;
 				IOLog("VEUX GUI: first valid software display present\n");
 				veux_fb_normal_status_clear();
+				veux_fb_touch_status_clear();
 				uint32_t quiet = 0;
 				if (PE_parse_boot_argn("veux_gui_noconsole", &quiet, sizeof(quiet)) && quiet == 1) {
 					veux_fb_gui_handoff();
 				}
 			}
-			veux_fb_touch_status_redraw();
 #endif
 		}
 		s->release();
