+/* Idle observer: one immutable, bounded snapshot; no sleeping locks in IRQ.
+ * cpus=1 + interrupted idle thread prevents global-list mutation while copied.
+ * A dedicated 100ms callout avoids relying on a tickless scheduler's tick rate.
+ * It changes wakeup frequency, not pmap barriers. */
+#define VW_MAX 128u
+#define VW_PER_PAGE 6u
+struct vw_thread {
+ uint64_t thread, state, event, result, hint, continuation, stack, fp, flags, ra[8];
+};
+static struct vw_thread vw_threads[VW_MAX];
+static unsigned int vw_count, vw_page, vw_pages, vw_page_ticks;
+static uint64_t vw_boot, vw_idle_since, vw_idle_samples, vw_tick_start, vw_tick_end;
+static uint64_t vw_runq, vw_rt, vw_truncated, vw_native_ticks;
+static bool vw_started, vw_captured;
+static struct timer_call vw_call;
+static uint64_t vw_bsd_mask;
+
+static bool
+vw_readable(uint64_t address, uint64_t size)
+{
+ if (!size || address < VM_MIN_KERNEL_ADDRESS || address + size < address) return false;
+ for (uint64_t p = address & ~16383ULL; p <= ((address + size - 1) & ~16383ULL); p += 16384)
+  if (vd_at(p, false) & 1) return false;
+ return true;
+}
+/* BEGIN VEUX FRAME CORE -- host test executes this actual bounded walker. */
+static void
+vw_unwind(struct vw_thread *t, uint64_t fp, uint64_t lr, uint64_t low, uint64_t high)
+{
+ t->fp = fp; t->ra[0] = lr;
+ for (unsigned int n = 1; n < 8 && fp; ++n) {
+  if ((fp & 15) || fp < low || high < 16 || fp > high - 16 || !vw_readable(fp, 16)) { t->flags |= 16; break; }
+  const volatile uint64_t *frame = (const void *)fp;
+  uint64_t next = frame[0]; t->ra[n] = frame[1];
+  if (next && next <= fp) { t->flags |= 32; break; }
+  fp = next;
+ }
+}
+/* END VEUX FRAME CORE */
+/* Each thread uses 9 rows: metadata x4, continuation/FP, then 8 RAs x4. */
+static void
+vw_show(void)
+{
+ if (vd_busy || vd_phase == 1 || vd_phase == 3 || vd_full_shown) return;
+ vd_busy = true;
+ volatile uint32_t *fb = (volatile uint32_t *)veux_stage_fb;
+ for (unsigned y = 868; y < 2072; ++y)
+  for (unsigned x = 0; x < 1080; ++x) fb[y * 1080 + x] = 0xff101010;
+ /* Header row IDs F0..F4; body IDs 00..35, fixed 20px pitch. */
+ unsigned int y = 872;
+ #define VW_ROW(id,a,b) do { vd_digit(16,y,(id)>>4); vd_digit(26,y,(id)); \
+  vd_hex(96,y,(uint64_t)(a)); vd_hex(512,y,(uint64_t)(b)); y += 20; } while (0)
+ VW_ROW(0xf0, vw_page, vw_pages);
+ VW_ROW(0xf1, vw_count, vw_truncated);
+ VW_ROW(0xf2, vw_tick_start, vw_tick_end);
+ VW_ROW(0xf3, vw_runq, vw_rt);
+ VW_ROW(0xf4, vw_idle_samples, vw_native_ticks);
+ unsigned int first = vw_page * VW_PER_PAGE;
+ for (unsigned int i = first; i < vw_count && i < first + VW_PER_PAGE; ++i) {
+  struct vw_thread *t = &vw_threads[i];
+  unsigned int id = (i - first) * 9;
+  VW_ROW(id, t->thread, t->state);
+  VW_ROW(id+1, t->event, t->result);
+  VW_ROW(id+2, t->hint, t->flags);
+  VW_ROW(id+3, t->continuation, t->fp);
+  VW_ROW(id+4, t->stack, i);
+  for (unsigned int j=0;j<4;++j) { VW_ROW(id+5+j,t->ra[2*j],t->ra[2*j+1]); }
+ }
+ #undef VW_ROW
+ veux_stage_flush(); /* all NB stores, one publication barrier per frozen page */
+ vd_busy = false;
+}
+static void
+vw_capture(void)
+{
+ processor_t cpu = current_processor();
+ vw_tick_end = sched_tick; vw_native_ticks = vd_ticks;
+ vw_rt = cpu->processor_set->rt_runq.count;
+#if CONFIG_SCHED_CLUTCH
+ vw_runq = cpu->processor_set->pset_clutch_root.scr_thr_count;
+#elif defined(CONFIG_SCHED_TRADITIONAL) || defined(CONFIG_SCHED_MULTIQ)
+ vw_runq = cpu->processor_set->pset_runq.count;
+#else
+ vw_runq = UINT64_MAX;
+#endif
+ queue_entry_t head = (queue_entry_t)&threads;
+ queue_entry_t link = queue_first(&threads);
+ while (link != head && vw_count < VW_MAX) {
+  uint64_t address = (uint64_t)link - __builtin_offsetof(struct thread, threads);
+  if (!vw_readable(address, sizeof(struct thread))) { vw_truncated = 2; break; }
+  thread_t th = (thread_t)address;
+  struct vw_thread *t = &vw_threads[vw_count++];
+  t->thread = address; t->state = (uint32_t)th->state | ((uint64_t)th->options << 32); t->event = th->wait_event;
+  t->result = (uint32_t)th->wait_result;
+  t->hint = (uint64_t)th->block_hint | ((uint64_t)th->pending_block_hint << 32);
+  t->continuation = (uint64_t)th->continuation; t->stack = th->kernel_stack;
+  if (address == vw_boot) t->flags |= 1;
+  if (th == cpu->idle_thread) t->flags |= 2;
+  /* Active idle context is not a saved blocked-thread stack. A continuation
+   * dispatch can discard the old stack: record it, never invent a backtrace. */
+  if (th == current_thread()) t->flags |= 4;
+  else if (th->continuation) t->flags |= 8;
+  else {
+   uint64_t low = t->stack, high = low + kernel_stack_size;
+   uint64_t context = th->machine.kstackptr;
+   if (low && high > low && context >= low && context <= high - sizeof(struct arm_kernel_saved_state) &&
+       vw_readable(context, sizeof(struct arm_kernel_saved_state))) {
+    const struct arm_kernel_saved_state *ss = (const void *)context;
+    vw_unwind(t, ss->fp, ss->lr, low, high);
+   } else t->flags |= 64;
+  }
+  queue_entry_t next = queue_next(&th->threads);
+  if (next == link) { vw_truncated = 3; break; }
+  link = next;
+ }
+ if (link != head && !vw_truncated) vw_truncated = 1;
+ vw_pages = (vw_count + VW_PER_PAGE - 1) / VW_PER_PAGE;
+ if (!vw_pages) vw_pages = 1;
+ vw_captured = true; vw_show();
+}
+static void
+vw_timer(timer_call_param_t unused0, timer_call_param_t unused1)
+{
+ (void)unused0; (void)unused1;
+ uint64_t saved_par = __builtin_arm_rsr64("PAR_EL1");
+ /* Timer interrupt context: no global thread-list mutex (could be held by
+  * interrupted code). Copy only on single CPU and interrupted idle thread. */
+ if (vd_phase != 1 && vd_phase != 3 && !vd_full_shown) {
+  if (!vw_captured) {
+   uint64_t now = __builtin_arm_rsr64("CNTVCT_EL0");
+   if (processor_count == 1 && current_thread() == current_processor()->idle_thread) {
+    if (!vw_idle_since) { vw_idle_since = now; vw_tick_start = sched_tick; vw_idle_samples = 0; }
+    ++vw_idle_samples;
+    if (now - vw_idle_since >= 5 * __builtin_arm_rsr64("CNTFRQ_EL0")) vw_capture();
+   } else vw_idle_since = 0;
+  } else if (++vw_page_ticks >= 20) {
+   vw_page_ticks = 0; vw_page = (vw_page + 1) % vw_pages; vw_show();
+  }
+ }
+ __builtin_arm_wsr64("PAR_EL1", saved_par);
+ uint64_t deadline; clock_interval_to_deadline(100, 1000000, &deadline);
+ timer_call_enter(&vw_call, deadline, TIMER_CALL_LOCAL);
+}
+void
+veux_wait_monitor_start(void)
+{
+ if (vw_started) return;
+ vw_started = true; vw_boot = (uint64_t)current_thread();
+ timer_call_setup(&vw_call, vw_timer, NULL);
+ uint64_t deadline; clock_interval_to_deadline(100, 1000000, &deadline);
+ timer_call_enter(&vw_call, deadline, TIMER_CALL_LOCAL);
+}
+void
+veux_bsd_stage(unsigned int stage)
+{
+ static const uint32_t colors[6] = {0xffffffff,0xffffff00,0xff00ff00,0xffff8000,0xff00ffff,0xffff00ff};
+ if (stage >= 6) return;
+ vw_bsd_mask |= 1ULL << stage;
+ volatile uint32_t *fb = (volatile uint32_t *)veux_stage_fb;
+ for (unsigned y=2080;y<2112;++y)
+  for (unsigned x=32+64*stage;x<64+64*stage;++x) fb[y*1080+x]=colors[stage];
+ veux_stage_flush();
+}
+
 #endif /* ARM64_BOARD_CONFIG_VEUX */
