@@ -0,0 +1,90 @@
+/* Early VEUX milestones go to the reserved ramoops pmsg ring, never scanout. */
+#include <arm64/sweet_early.h>
+
+#if defined(VEUX)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+#include <pexpert/arm/protos.h>
+
+#define VEUX_EARLY_PENDING_SIZE 2048u
+static char veux_early_pending[VEUX_EARLY_PENDING_SIZE];
+static unsigned int veux_early_pending_size;
+static bool veux_early_ready;
+static bool veux_early_overflow;
+static bool veux_early_panicking;
+
+static void
+veux_early_putc(char c)
+{
+	if (veux_early_ready) {
+		veux_pmsg_putc(c);
+		return;
+	}
+	if (veux_early_pending_size < sizeof(veux_early_pending)) {
+		veux_early_pending[veux_early_pending_size++] = c;
+	} else {
+		veux_early_overflow = true;
+	}
+}
+
+static void
+veux_early_string(const char *s)
+{
+	while (*s != '\0') {
+		veux_early_putc(*s++);
+	}
+}
+
+static void
+veux_early_uint(unsigned int value)
+{
+	char digits[10];
+	unsigned int count = 0;
+	do {
+		digits[count++] = (char)('0' + value % 10);
+		value /= 10;
+	} while (value != 0 && count < sizeof(digits));
+	while (count != 0) {
+		veux_early_putc(digits[--count]);
+	}
+}
+
+void
+sweet_early_mark(unsigned int stage, const char *label)
+{
+	veux_early_string("VEUX EARLY ");
+	veux_early_uint(stage);
+	veux_early_string(": ");
+	veux_early_string(label);
+	veux_early_putc('\n');
+}
+
+void
+sweet_early_panic(const char *fmt, va_list *args)
+{
+	if (veux_early_panicking) {
+		return;
+	}
+	veux_early_panicking = true;
+	veux_early_string("\nVEUX EARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, veux_early_putc, 16);
+	va_end(copy);
+	veux_early_putc('\n');
+}
+
+void
+veux_early_flush(void)
+{
+	veux_early_ready = true;
+	for (unsigned int i = 0; i < veux_early_pending_size; i++) {
+		veux_pmsg_putc(veux_early_pending[i]);
+	}
+	veux_early_pending_size = 0;
+	if (veux_early_overflow) {
+		veux_early_string("VEUX EARLY: pending log truncated\n");
+		veux_early_overflow = false;
+	}
+}
