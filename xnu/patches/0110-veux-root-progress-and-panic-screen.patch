+static void
+veux_panic_hex(uint64_t value)
+{
+	static const char digits[] = "0123456789abcdef";
+	for (int shift = 60; shift >= 0; shift -= 4) veux_fb_panic_putc(digits[(value >> shift) & 15]);
+}
+void
+veux_panic_screen(const char *fmt, va_list *args, unsigned long caller)
+{
+	veux_fb_panic_begin();
+	veux_fb_panic_putc('P'); veux_fb_panic_putc('A'); veux_fb_panic_putc('N');
+	veux_fb_panic_putc('I'); veux_fb_panic_putc('C'); veux_fb_panic_putc(':'); veux_fb_panic_putc(' ');
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, veux_fb_panic_putc, 16);
+	va_end(copy);
+	veux_fb_panic_putc('\n');
+	const char *label = "caller=0x"; while (*label) veux_fb_panic_putc(*label++);
+	veux_panic_hex((uint64_t)caller); veux_fb_panic_putc('\n');
+	thread_t thread = current_thread();
+	uintptr_t low = thread ? (uintptr_t)thread->kernel_stack : 0;
