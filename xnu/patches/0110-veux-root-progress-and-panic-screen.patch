+
+static uint32_t veux_fb_panic_col, veux_fb_panic_row;
+void
+veux_fb_panic_begin(void)
+{
+	if (!veux_fb_console_ready || veux_fb_console_base == NULL) return;
+	veux_fb_panic_col = veux_fb_panic_row = 0;
+	for (uint32_t y = 1816; y < 2072; ++y)
+		for (uint32_t x = 0; x < VEUX_FB_WIDTH; ++x)
+			veux_fb_console_base[y * (veux_fb_console_stride / 4u) + x] = 0xff000000;
+}
+
+void
+veux_fb_panic_putc(char c)
+{
+	if (!veux_fb_console_ready || veux_fb_console_base == NULL) return;
+	const uint32_t cols = VEUX_FB_WIDTH / 8u;
+	const uint32_t rows = (2072u - 1816u) / 16u;
+	if (c == '\r') { veux_fb_panic_col = 0; return; }
+	if (c == '\n' || veux_fb_panic_col >= cols) {
+		veux_fb_panic_col = 0;
+		if (++veux_fb_panic_row >= rows) return;
+		if (c == '\n') return;
+	}
+	unsigned char ch = (unsigned char)c;
+	if (ch < 0x20 || ch > 0x7e) ch = '?';
+	const unsigned char *glyph = iso_font + (uint32_t)ch * 16u;
+	uint32_t x0 = veux_fb_panic_col * 8u;
+	uint32_t y0 = 1816u + veux_fb_panic_row * 16u;
+	for (uint32_t gy = 0; gy < 16; ++gy) {
+		volatile uint32_t *line = veux_fb_console_base + (y0 + gy) * (veux_fb_console_stride / 4u) + x0;
+		for (uint32_t gx = 0; gx < 8; ++gx)
+			line[gx] = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+	}
+	veux_fb_panic_col++;
+}
