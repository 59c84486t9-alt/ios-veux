From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Keep VEUX touch diagnostics visible over GUI

Keep a five-entry touch-stage history below the notch, redraw it after each
successful GUI framebuffer present, and expose I2C IRQ/status on probe errors.

diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 601760d..2312c80 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -162,6 +162,7 @@ touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out,
 	}
 #if defined(ARM64_BOARD_CONFIG_VEUX)
 	if (!ok) {
+		veux_fb_touch_status(7, pin);
 		printf("VEUX TOUCH: GPIO%u write/readback failed cfg=%#x wanted=%#x io=%#x out=%u high=%u\n",
 		    pin, touch_rd(st.gpio, off), cfg, touch_rd(st.gpio, TOUCH_GPIO_IO(pin)),
 		    out ? 1u : 0u, high ? 1u : 0u);
@@ -370,6 +371,13 @@ touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
 		    err, st.irq_last, st.irq_status, st.sent, st.got,
 		    touch_rd(st.se, SE_STATUS));
 	}
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	if (err) {
+		veux_fb_touch_status(15, st.irq_status);
+		veux_fb_touch_status(16, ((touch_rd(st.se, SE_STATUS) & 0xffffu) << 16) |
+		    ((st.sent & 0xffu) << 8) | (st.got & 0xffu));
+	}
+#endif
 	return err;
 }
 
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -1700,8 +1707,14 @@
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
-void
-veux_fb_touch_status(unsigned int state, unsigned int detail)
+#define VEUX_TOUCH_STATUS_HISTORY 5u
+static volatile unsigned int veux_fb_touch_state[VEUX_TOUCH_STATUS_HISTORY] = {
+	0xffffffffu, 0xffffffffu, 0xffffffffu, 0xffffffffu, 0xffffffffu
+};
+static volatile unsigned int veux_fb_touch_detail[VEUX_TOUCH_STATUS_HISTORY];
+
+static void
+veux_fb_touch_status_draw(unsigned int state, unsigned int detail, unsigned int row)
 {
 	if (!veux_fb_console_base) return;
 	const char *message = state == 0 ? "TOUCH: worker started" :
@@ -1709,29 +1722,42 @@
 	    state == 2 ? "TOUCH: GCC and SE8 setup" :
 	    state == 3 ? "TOUCH: GPIO and power setup" :
 	    state == 4 ? "TOUCH: reading GT9896 ID" :
-	    state == 5 ? "TOUCH: GT9896 ID read OK" : "TOUCH: GT9896 ID read FAILED";
+	    state == 5 ? "TOUCH: GT9896 ID read OK" :
+	    state == 6 ? "TOUCH: GT9896 ID read FAILED" :
+	    state == 7 ? "TOUCH: GPIO write/readback FAILED pin=" :
+	    state == 8 ? "TOUCH: GCC clock setup FAILED" :
+	    state == 9 ? "TOUCH: MMIO map failed mask=" :
+	    state == 10 ? "TOUCH: SE8 setup FAILED" :
+	    state == 11 ? "TOUCH: report read FAILED err=" :
+	    state == 13 ? "TOUCH: GT9896 report polling" :
+	    state == 14 ? "TOUCH: unsupported/no unique IC flags=" :
+	    state == 15 ? "TOUCH: I2C IRQ bits" :
+	    state == 16 ? "TOUCH: SE/tx/rx" :
+	    "TOUCH: unknown state";
 	volatile uint32_t *fb = veux_fb_console_base;
-	const uint32_t x0 = 12, y0 = 44, pad = 6;
+	const uint32_t stride = veux_fb_console_stride / 4u;
+	const uint32_t x0 = 12, y0 = 160u + row * 32u, pad = 6;
 	uint32_t msg_len = 0;
 	while (message[msg_len]) ++msg_len;
-	const uint32_t width = (msg_len + 17u) * 8u + pad * 2u;
+	const uint32_t width = (msg_len + 10u) * 8u + pad * 2u;
+	if (!stride || x0 + width >= VEUX_FB_WIDTH || y0 + 16u + pad * 2u >= VEUX_FB_HEIGHT) return;
 	for (uint32_t y = y0; y < y0 + 16u + pad * 2u; ++y)
-		for (uint32_t x = x0; x < x0 + width; ++x) fb[y * VEUX_FB_WIDTH + x] = 0xff000000u;
+		for (uint32_t x = x0; x < x0 + width; ++x) fb[y * stride + x] = 0xff000000u;
 	uint32_t x = x0 + pad;
 	for (const unsigned char *c = (const unsigned char *)message; *c; ++c, x += 8u) {
 		for (unsigned y = 0; y < 16; ++y) {
 			unsigned char bits = iso_font[(unsigned)*c * 16u + y];
 			for (unsigned b = 0; b < 8; ++b) if (bits & (0x80u >> b))
-				fb[(y0 + pad + y) * VEUX_FB_WIDTH + x + b] = 0xffffffffu;
+				fb[(y0 + pad + y) * stride + x + b] = 0xffffffffu;
 		}
 	}
-	static const char prefix[] = " err=0x";
+	static const char prefix[] = "0x";
 	static const char hex[] = "0123456789ABCDEF";
 	for (const unsigned char *c = (const unsigned char *)prefix; *c; ++c, x += 8u) {
 		for (unsigned y = 0; y < 16; ++y) {
 			unsigned char bits = iso_font[(unsigned)*c * 16u + y];
 			for (unsigned b = 0; b < 8; ++b) if (bits & (0x80u >> b))
-				fb[(y0 + pad + y) * VEUX_FB_WIDTH + x + b] = 0xffffffffu;
+				fb[(y0 + pad + y) * stride + x + b] = 0xffffffffu;
 		}
 	}
 	for (int shift = 28; shift >= 0; shift -= 4, x += 8u) {
@@ -1739,10 +1763,33 @@
 		for (unsigned y = 0; y < 16; ++y) {
 			unsigned char bits = iso_font[(unsigned)c * 16u + y];
 			for (unsigned b = 0; b < 8; ++b) if (bits & (0x80u >> b))
-				fb[(y0 + pad + y) * VEUX_FB_WIDTH + x + b] = 0xffffffffu;
+				fb[(y0 + pad + y) * stride + x + b] = 0xffffffffu;
 		}
 	}
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
+void veux_fb_touch_status_redraw(void);
+
+void
+veux_fb_touch_status(unsigned int state, unsigned int detail)
+{
+	for (unsigned int i = VEUX_TOUCH_STATUS_HISTORY - 1u; i > 0; --i) {
+		veux_fb_touch_state[i] = veux_fb_touch_state[i - 1u];
+		veux_fb_touch_detail[i] = veux_fb_touch_detail[i - 1u];
+	}
+	veux_fb_touch_detail[0] = detail;
+	veux_fb_touch_state[0] = state;
+	veux_fb_touch_status_redraw();
+}
+void
+veux_fb_touch_status_redraw(void)
+{
+	for (unsigned int row = 0; row < VEUX_TOUCH_STATUS_HISTORY; ++row) {
+		unsigned int state = veux_fb_touch_state[row];
+		if (state != 0xffffffffu)
+			veux_fb_touch_status_draw(state, veux_fb_touch_detail[row], row);
+	}
+}
+
 #endif /* ARM64_BOARD_CONFIG_VEUX */
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -39,6 +39,7 @@
 extern "C" void veux_fb_gui_handoff(void);
 extern "C" void veux_fb_normal_status_draw(void);
 extern "C" void veux_fb_normal_status_clear(void);
+extern "C" void veux_fb_touch_status_redraw(void);
 extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
 
 #if defined(SWEET) || defined(ARM64_BOARD_CONFIG_VEUX)
@@ -568,6 +569,7 @@
 					veux_fb_gui_handoff();
 				}
 			}
+			veux_fb_touch_status_redraw();
 #endif
 		}
 		s->release();
-- 
