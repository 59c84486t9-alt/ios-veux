+void
+veux_fb_normal_status_draw(void)
+{
+	if (!veux_fb_console_base || veux_fb_console_ready) return;
+	static const char text[] = "variant=normal ID=";
+	const char *id = build_id_line;
+	while (*id && *id != '=') ++id;
+	if (*id == '=') ++id;
+	const char *id_end = id;
+	while (*id_end && *id_end != '\n') ++id_end;
+	volatile uint32_t *fb = veux_fb_console_base;
+	const uint32_t x0 = 12, y0 = 12, pad = 4;
+	const uint32_t width = (uint32_t)(sizeof(text) - 1 + (id_end - id)) * 8u + pad * 2;
+	for (uint32_t y = y0; y < y0 + 16 + pad * 2; ++y)
+		for (uint32_t x = x0; x < x0 + width; ++x) fb[y * VEUX_FB_WIDTH + x] = 0xff000000u;
+	uint32_t x = x0 + pad;
+	for (const unsigned char *c = (const unsigned char *)text; *c; ++c, x += 8) {
+		for (unsigned y = 0; y < 16; ++y) {
+			unsigned char bits = iso_font[(unsigned)*c * 16 + y];
+			for (unsigned b = 0; b < 8; ++b) if (bits & (0x80u >> b))
+				fb[(y0 + pad + y) * VEUX_FB_WIDTH + x + b] = 0xffffffffu;
+		}
+	}
+	for (const unsigned char *c = (const unsigned char *)id; c < (const unsigned char *)id_end; ++c, x += 8) {
+			for (unsigned y = 0; y < 16; ++y) {
+				unsigned char bits = iso_font[(unsigned)*c * 16 + y];
+				for (unsigned b = 0; b < 8; ++b) if (bits & (0x80u >> b))
+					fb[(y0 + pad + y) * VEUX_FB_WIDTH + x + b] = 0xffffffffu;
+			}
+	}
+	veux_fb_status_active = true;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+veux_fb_normal_status_clear(void)
+{
+	if (!veux_fb_status_active || !veux_fb_console_base) return;
+	volatile uint32_t *fb = veux_fb_console_base;
+	const uint32_t x0 = 12, y0 = 12, width = 240, height = 24;
+	for (uint32_t y = y0; y < y0 + height; ++y)
+		for (uint32_t x = x0; x < x0 + width; ++x) fb[y * VEUX_FB_WIDTH + x] = 0xff000000u;
+	veux_fb_status_active = false;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
