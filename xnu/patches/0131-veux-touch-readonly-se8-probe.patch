From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Add an opt-in read-only VEUX SE8 touch probe

The VEUX screen now reaches SpringBoard, but the SWEET touch path uses a
separate controller and GPIO map. Add a VEUX-only boot-arg-gated register
snapshot for the phone's SE8, GCC and touch GPIOs. It performs no MMIO writes
and sends no I2C transactions; this captures ABL handoff state before any
controller or power sequencing is attempted.

diff --git a/bsd/conf/files b/bsd/conf/files
index 6630131..3cf2834 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -108,6 +108,7 @@ bsd/dev/sweet_ufs.c			standard
 bsd/dev/sweet_sample.c			standard
 bsd/dev/sweet_keys.c			standard
 bsd/dev/sweet_touch.c			standard
+bsd/dev/veux_touch_probe.c		standard
 bsd/dev/sweet_rpmh.c			standard
 bsd/dev/sweet_spmi.c			standard
 bsd/dev/sweet_usb.c			standard
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 7adee14..a32f477 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -661,6 +661,11 @@ sweet_ufs_init(void)
 	sweet_keys_init();
 	sweet_touch_init();
 	sweet_usb_probe();
 #endif
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	extern void veux_touch_probe_init(void);
+	/* Read-only controller/rail snapshot; disabled unless explicitly requested. */
+	veux_touch_probe_init();
+#endif
 	return 0;
 }
diff --git a/bsd/dev/veux_touch_probe.c b/bsd/dev/veux_touch_probe.c
new file mode 100644
index 0000000..d5de204
--- /dev/null
+++ b/bsd/dev/veux_touch_probe.c
@@ -0,0 +1,95 @@
+/*
+ * VEUX GT9896 first-stage probe. This path is strictly read-only: it snapshots
+ * the SE8, GCC and TLMM state inherited at XNU startup and never sends I2C.
+ * Keep it opt-in until the exact ABL controller/clock handoff is understood.
+ */
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define VEUX_TOUCH_SE_PA       0x04c88000u
+#define VEUX_TOUCH_GCC_PA      0x01400000u
+#define VEUX_TOUCH_TLMM_PA     0x00400000u
+#define VEUX_TOUCH_SE_SIZE     0x4000u
+#define VEUX_TOUCH_GCC_SIZE    0x80000u
+#define VEUX_TOUCH_TLMM_SIZE   0x35000u
+
+#define SE_STATUS              0x040u
+#define SE_M_CLK               0x048u
+#define SE_FW_REV              0x068u
+#define SE_CLK_SEL             0x07cu
+#define SE_IRQ                 0x610u
+#define SE_IRQ_EN              0x614u
+#define SE_TX_COUNT            0x800u
+#define SE_RX_COUNT            0x804u
+
+/* Blair GCC values from the pinned platform clock source for GENI SE8. */
+#define GCC_QUP1_S2_CMD_RCGR   0x5327cu
+#define GCC_QUP1_S2_BRANCH     0x53278u
+#define GCC_QUP1_M_AHB_BRANCH  0x53004u
+#define GCC_QUP1_S_AHB_BRANCH  0x53008u
+#define GCC_BRANCH_VOTE        0x7900cu
+
+#define TLMM_GPIO_CFG(pin)     ((uint32_t)(pin) * 0x1000u)
+#define TLMM_GPIO_INOUT(pin)   (TLMM_GPIO_CFG(pin) + 4u)
+
+static uint32_t
+touch_probe_rd(vm_offset_t base, uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(base + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+touch_probe_gpio(vm_offset_t tlmm, unsigned pin, const char *label)
+{
+	uint32_t cfg = touch_probe_rd(tlmm, TLMM_GPIO_CFG(pin));
+	uint32_t io = touch_probe_rd(tlmm, TLMM_GPIO_INOUT(pin));
+	printf("VEUX TOUCH PROBE: gpio%u %s cfg=%#x io=%#x\n", pin, label, cfg, io);
+}
+
+void
+veux_touch_probe_init(void)
+{
+	int enabled = 0;
+	if (!PE_parse_boot_argn("veuxtouchprobe", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+
+	vm_offset_t se = ml_io_map(VEUX_TOUCH_SE_PA, VEUX_TOUCH_SE_SIZE);
+	vm_offset_t gcc = ml_io_map(VEUX_TOUCH_GCC_PA, VEUX_TOUCH_GCC_SIZE);
+	vm_offset_t tlmm = ml_io_map(VEUX_TOUCH_TLMM_PA, VEUX_TOUCH_TLMM_SIZE);
+	if (!se || !gcc || !tlmm) {
+		printf("VEUX TOUCH PROBE: read-only SE8 mapping failed se=%u gcc=%u tlmm=%u\n",
+		    se != 0, gcc != 0, tlmm != 0);
+		return;
+	}
+
+	printf("VEUX TOUCH PROBE: read-only SE8 fw=%#x status=%#x mclk=%#x clk_sel=%#x irq=%#x irq_en=%#x tx_count=%#x rx_count=%#x\n",
+	    touch_probe_rd(se, SE_FW_REV), touch_probe_rd(se, SE_STATUS),
+	    touch_probe_rd(se, SE_M_CLK), touch_probe_rd(se, SE_CLK_SEL),
+	    touch_probe_rd(se, SE_IRQ), touch_probe_rd(se, SE_IRQ_EN),
+	    touch_probe_rd(se, SE_TX_COUNT), touch_probe_rd(se, SE_RX_COUNT));
+	printf("VEUX TOUCH PROBE: read-only GCC rcgr=%#x cfg=%#x branch=%#x m_ahb=%#x s_ahb=%#x vote=%#x\n",
+	    touch_probe_rd(gcc, GCC_QUP1_S2_CMD_RCGR),
+	    touch_probe_rd(gcc, GCC_QUP1_S2_CMD_RCGR + 4u),
+	    touch_probe_rd(gcc, GCC_QUP1_S2_BRANCH),
+	    touch_probe_rd(gcc, GCC_QUP1_M_AHB_BRANCH),
+	    touch_probe_rd(gcc, GCC_QUP1_S_AHB_BRANCH),
+	    touch_probe_rd(gcc, GCC_BRANCH_VOTE));
+
+	/* 19/20=SE8 SDA/SCL; 21=reset; 22=IRQ; 44/51=DVDD/AVDD. */
+	touch_probe_gpio(tlmm, 19, "SE8-SDA");
+	touch_probe_gpio(tlmm, 20, "SE8-SCL");
+	touch_probe_gpio(tlmm, 21, "reset");
+	touch_probe_gpio(tlmm, 22, "irq");
+	touch_probe_gpio(tlmm, 44, "dvdd");
+	touch_probe_gpio(tlmm, 51, "avdd");
+	printf("VEUX TOUCH PROBE: done; no GPIO/GCC/SE writes and no I2C transfer\n");
+}
+#endif /* ARM64_BOARD_CONFIG_VEUX */
