+static uint32_t fw_crc32(const uint8_t *p, uint64_t n) {
+	uint32_t c=0xffffffffU; for(uint64_t i=0;i<n;i++){ c^=p[i]; for(unsigned b=0;b<8;b++) c=(c>>1)^(0xedb88320U&(0U-(c&1U))); } return ~c;
+}
+const struct fw_file *veux_fw_find(const char *name) {
+	for(unsigned i=0;i<sizeof(fw_files)/sizeof(fw_files[0]);i++) if(strcmp(fw_files[i].name,name)==0)return &fw_files[i]; return NULL;
+}
+int64_t veux_fw_read(const char *name,uint64_t off,void *dst,uint64_t len) {
+	const struct fw_file *f=veux_fw_find(name); if(!f||off>f->size||len>(uint64_t)f->size-off||(!dst&&len))return -1;
+	if(sweet_ufs_read_part("modem_a",(uint64_t)f->offset+off,dst,len)!=(int64_t)len){ printf("VEUX MODEM FW: %s read failed\n",name); return -1; }
+	if(off==0&&len==f->size){ uint32_t got=fw_crc32(dst,len); if(got!=f->crc32)printf("VEUX MODEM FW: %s crc mismatch got=0x%08x want=0x%08x\n",name,got,f->crc32); printf("VEUX MODEM FW: %s 0x%x %u %s\n",name,f->offset,f->size,got==f->crc32?"crc-ok":"crc-warning"); }
+	return (int64_t)len;
