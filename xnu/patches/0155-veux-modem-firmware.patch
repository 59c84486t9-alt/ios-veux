diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -48,6 +48,7 @@
 extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
 extern void thread_deallocate(thread_t);
 extern int hz;
+int64_t sweet_ufs_read_part(const char *name, uint64_t off, void *dst, uint64_t len);
 static void sweet_log_start(void);
 #if defined(ARM64_BOARD_CONFIG_VEUX)
 static void veux_log_start(bool userdata_partition);
@@ -407,6 +408,44 @@
 	}
 	printf("SWEET/VEUX UFS: no GPT partition named \"%s\"\n", want);
 	return ENOENT;
+}
+
+/* Read-only byte access to a named GPT partition for modem firmware. */
+int64_t
+sweet_ufs_read_part(const char *name, uint64_t off, void *dst, uint64_t len)
+{
+	uint64_t saved_first, saved_count, target_first, target_count;
+	int error = 0;
+	if (!su.ready || name == NULL || dst == NULL || len == 0 || strcmp(name, "modem_a") != 0)
+		return -1;
+	lck_mtx_lock(&sweet_ufs_lock);
+	saved_first = su.first_block;
+	saved_count = su.nblocks;
+	error = ufs_find_partition(name);
+	target_first = su.first_block;
+	target_count = su.nblocks;
+	if (error == 0 && (off > target_count * (uint64_t)UFS_BLOCK ||
+	    len > target_count * (uint64_t)UFS_BLOCK - off)) error = EINVAL;
+	for (uint64_t done = 0; error == 0 && done < len;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t take = (uint32_t)MIN(len - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + take + UFS_BLOCK - 1) / UFS_BLOCK;
+		error = ufs_read_blocks(target_first + lba, blocks);
+		if (error == 0) {
+			volatile uint8_t *dest = (volatile uint8_t *)((uint8_t *)dst + done);
+			const uint8_t *src = (const uint8_t *)(su.dma + DMA_BOUNCE) + skip;
+			for (uint32_t k = 0; k < take; k++) {
+				dest[k] = src[k];
+			}
+		}
+		done += error == 0 ? take : 0;
+	}
+	su.first_block = saved_first;
+	su.nblocks = saved_count;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error == 0 ? (int64_t)len : -1;
 }
 
 static int
