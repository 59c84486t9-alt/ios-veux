diff --git a/iokit/Kernel/arm/VeuxModemMap.cpp b/iokit/Kernel/arm/VeuxModemMap.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/VeuxModemMap.cpp
@@ -0,0 +1,27 @@
+#include <IOKit/IOMemoryDescriptor.h>
+#include <stdint.h>
+
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+
+/* Keep mappings alive for the modem firmware's lifetime. */
+static IOMemoryMap *veux_modem_segment_maps[64];
+static uint32_t veux_modem_segment_map_count;
+
+extern "C" void *
+veux_modem_map_phys(uint64_t pa, uint64_t size)
+{
+ IOMemoryDescriptor *descriptor;
+ IOMemoryMap *mapping;
+ if(size==0||pa>UINT64_MAX-size||veux_modem_segment_map_count>=64)return 0;
+ descriptor=IOMemoryDescriptor::withPhysicalAddress((IOPhysicalAddress)pa,(IOByteCount)size,kIODirectionInOut);
+ if(!descriptor)return 0;
+ mapping=descriptor->map(kIOMapWriteCombineCache);
+ descriptor->release();
+ if(!mapping)return 0;
+ if(!mapping->getVirtualAddress()){mapping->release();return 0;}
+ veux_modem_segment_maps[veux_modem_segment_map_count++]=mapping;
+ return (void *)mapping->getVirtualAddress();
+}
+
+#endif
+
