 	const uint32_t cols = VEUX_FB_WIDTH / (8u * VEUX_FB_CONSOLE_SCALE);
-	const uint32_t rows = (VEUX_FB_HEIGHT - VEUX_FB_CONSOLE_TOP) / (16u * VEUX_FB_CONSOLE_SCALE);
+	const uint32_t rows = (2240u - VEUX_FB_CONSOLE_TOP) / (16u * VEUX_FB_CONSOLE_SCALE);
 	if (c == '\r') {
 		veux_fb_console_col = 0;
 		return;
