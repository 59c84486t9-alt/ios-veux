From: ios-veux
Subject: [PATCH] Add RGB-probe-validated VEUX early stage cells

The 1080x2400/4320 splash pattern was observed on the phone. Map only
its 12 MiB reservation with 16K L3 pages, retain an alias through TTBR0
teardown, and keep six stage cells below the text console. GIC completion
is configuration evidence, not proof of interrupt delivery.

diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -218,8 +218,33 @@
  * only the kernel entry point.  Reset vector = (__start & ~0xfff)
  */
 	.align	3
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+/* Six 32x32 cells at y=2304. The RGB probe validated PA/stride on this phone.
+ * Scratch x9-x14 only: preserve boot args x0 and cold-boot x20-x27. */
+.macro veux_mark_block
+	MOV64 x9, (0x85200000 + 2304 * 4320 + 32 * 4 + $0 * 64 * 4)
+	MOV64 x10, $1
+	mov x11, #32
+	mov x13, #4320
+91:
+	mov x12, #32
+	mov x14, x9
+92:
+	str w10, [x14], #4
+	subs x12, x12, #1
+	b.ne 92b
+	add x9, x9, x13
+	subs x11, x11, #1
+	b.ne 91b
+	dsb sy
+.endmacro
+#endif
+
 	.globl EXT(_start)
 LEXT(_start)
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	veux_mark_block 0, 0xffff0000
+#endif
 	b	EXT(start_first_cpu)
 
 
@@ -695,6 +720,39 @@
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
 #endif
 
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	/* Exact 12 MiB L3 mapping; leave all neighboring carve-outs unmapped.
+	 * Bootstrap RAM is in L1 slot 0 for this 16K/4GiB-high-bank profile. */
+	adrp x14, EXT(veux_early_fb_l3)@page
+	add x14, x14, EXT(veux_early_fb_l3)@pageoff
+	mov x15, #TTE_PGENTRIES
+	mov x16, x14
+93:
+	str xzr, [x16], #8
+	subs x15, x15, #1
+	b.ne 93b
+	MOV64 x10, 0x85200000
+	MOV64 x11, (ARM_TTE_TYPE_TABLE | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr x11, x11, x10
+	MOV64 x16, (0x1200000 / 16384 * 8)
+	add x16, x14, x16
+	mov x15, #(0xc00000 / 16384)
+94:
+	str x11, [x16], #8
+	add x11, x11, #16384
+	subs x15, x15, #1
+	b.ne 94b
+	/* Walk the existing V=P L1 table instead of replacing its RAM mapping. */
+	and x12, x10, #(ARM_TT_L1_INDEX_MASK)
+	lsr x12, x12, #(ARM_TT_L1_SHIFT)
+	ldr x13, [x25, x12, lsl #TTE_SHIFT]
+	and x13, x13, #(ARM_TTE_TABLE_MASK)
+	and x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr x12, x12, #(ARM_TT_L2_SHIFT)
+	orr x14, x14, #(ARM_TTE_TYPE_TABLE | ARM_TTE_VALID)
+	str x14, [x13, x12, lsl #TTE_SHIFT]
+#endif
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
@@ -842,6 +900,11 @@
 	cmp		x0, x1
 	bne		.
 #endif /* !VMAPPLE && !SWEET && !ARM64_BOARD_CONFIG_VEUX */
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	cbnz x21, 95f
+	veux_mark_block 1, 0xffff8000
+95:
+#endif
 
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
 	/* Watchtower
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1852,6 +1852,25 @@
 }
 #endif
 
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+_Static_assert(ARM_PGBYTES == 16384, "VEUX breadcrumb page table requires 16K pages");
+SECURITY_READ_ONLY_LATE(tt_entry_t) veux_early_fb_l3[TTE_PGENTRIES] __attribute__((aligned(ARM_PGBYTES)));
+#define VEUX_EARLY_ALIAS (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+static void
+veux_early_map_final(void)
+{
+	const vm_map_address_t va = VEUX_EARLY_ALIAS;
+	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+	assert(*slot == ARM_TTE_EMPTY);
+	*slot = kvtophys((vm_offset_t)veux_early_fb_l3) | ARM_TTE_VALID | ARM_TTE_TYPE_TABLE;
+	__asm__ volatile("dsb ishst" ::: "memory");
+}
+#endif
+
 void
 arm_vm_init(uint64_t memory_size, boot_args * args)
 {
@@ -2183,6 +2202,8 @@
 #if defined(SWEET)
 	/* phystokv() must still refer to the bootstrap aperture here. */
 	sweet_early_map_final();
+#elif defined(ARM64_BOARD_CONFIG_VEUX)
+	veux_early_map_final();
 #endif
 	arm_vm_physmap_init(args);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
@@ -2192,6 +2213,8 @@
 #if defined(SWEET)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
 	sweet_early_relocate(SWEET_EARLY_FB_VA);
+#elif defined(ARM64_BOARD_CONFIG_VEUX)
+	veux_early_relocate(VEUX_EARLY_ALIAS + 0x1200000);
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
diff --git a/osfmk/arm64/veux_early.c b/osfmk/arm64/veux_early.c
--- a/osfmk/arm64/veux_early.c
+++ b/osfmk/arm64/veux_early.c
@@ -1,4 +1,4 @@
-/* Early VEUX milestones go to the reserved ramoops pmsg ring, never scanout. */
+/* VEUX early text plus RGB-probe-validated framebuffer stage cells. */
 #include <arm64/sweet_early.h>
 
 #if defined(ARM64_BOARD_CONFIG_VEUX)
@@ -49,9 +49,41 @@
 	}
 }
 
+
+/* Low splash RAM is outside the high-bank physmap. start.s provides a
+ * narrow identity alias; arm_vm_init switches us to a permanent kernel VA. */
+static uintptr_t veux_stage_fb = 0x85200000;
+void
+veux_early_relocate(uint64_t base)
+{
+	veux_stage_fb = (uintptr_t)base;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+void
+veux_stage_mark(unsigned int cell)
+{
+	static const uint32_t colors[6] = {
+		0xffff0000u, 0xffff8000u, 0xffffff00u,
+		0xff00ff00u, 0xff00ffffu, 0xffff00ffu
+	};
+	if (cell >= 6) return;
+	volatile uint32_t *fb = (volatile uint32_t *)veux_stage_fb;
+	for (unsigned int y = 2304; y < 2336; y++) {
+		for (unsigned int x = 32 + cell * 64; x < 64 + cell * 64; x++) {
+			fb[y * (4320 / 4) + x] = colors[cell];
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	veux_early_string("VEUX COLOR CELL ");
+	veux_early_uint(cell);
+	veux_early_putc('\n');
+}
+
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
+	if (stage == 1) veux_stage_mark(2); /* arm_init entry */
+	if (stage == 2) veux_stage_mark(3); /* PE_init_platform / DT complete */
 	veux_early_string("VEUX EARLY ");
 	veux_early_uint(stage);
 	veux_early_string(": ");
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
--- a/osfmk/arm64/sweet_early.h
+++ b/osfmk/arm64/sweet_early.h
@@ -16,6 +16,8 @@
 void sweet_early_mark(unsigned int stage, const char *label);
 void sweet_early_panic(const char *fmt, va_list *args);
 void veux_early_flush(void);
+void veux_early_relocate(uint64_t base);
+void veux_stage_mark(unsigned int cell);
 static inline void sweet_early_disable(void) {}
 #else
 static inline void sweet_early_mark(unsigned int stage, const char *label)
