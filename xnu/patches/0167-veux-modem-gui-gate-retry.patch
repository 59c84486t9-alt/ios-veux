From 0000000000000000000000000000000000000007 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Subject: [PATCH] Retry modem GUI gate after framebuffer client readiness

The first valid framebuffer present can precede the accepted backboardd or
SpringBoard client. Retry the guarded modem start on later presents and client
readiness, and expose the gate state in the filtered modem overlay.

--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -89,6 +89,8 @@
 static volatile uint32_t veux_gui_first_present;
 static bool veux_modem_overlay_checked;
 static bool veux_modem_overlay_enabled;
+static volatile uint32_t veux_modem_gui_gate_pending_logged;
+static volatile uint32_t veux_modem_gui_gate_dispatched;
 static volatile uint64_t veux_gui_selector_mask;
 static char veux_gui_init_process[32] = "none";
 static char veux_gui_ready_process[32] = "none";
@@ -108,6 +110,31 @@
 	dst[31] = '\0';
 }
 
+static void
+veux_gui_modem_gate_try(const char *stage)
+{
+	if (!veux_gui_first_present) {
+		return;
+	}
+	bool accepted = strcmp(veux_gui_init_process, "backboardd") == 0 ||
+	    strcmp(veux_gui_init_process, "SpringBoard") == 0 ||
+	    strcmp(veux_gui_ready_process, "backboardd") == 0 ||
+	    strcmp(veux_gui_ready_process, "SpringBoard") == 0;
+	if (!accepted) {
+		if (__atomic_exchange_n(&veux_modem_gui_gate_pending_logged, 1u, __ATOMIC_ACQ_REL) == 0u) {
+			IOLog("VEUX MODEM: GUI gate pending present=%u init=%s ready=%s stage=%s\n",
+			    (unsigned int)veux_gui_first_present, veux_gui_init_process,
+			    veux_gui_ready_process, stage);
+		}
+		return;
+	}
+	if (__atomic_exchange_n(&veux_modem_gui_gate_dispatched, 1u, __ATOMIC_ACQ_REL) == 0u) {
+		IOLog("VEUX MODEM: GUI gate open init=%s ready=%s stage=%s\n",
+		    veux_gui_init_process, veux_gui_ready_process, stage);
+		veux_modem_gui_ready();
+	}
+}
+
 extern "C" void
 veux_gui_process_exit_summary(void)
 {
@@ -583,14 +610,12 @@
 				IOLog("VEUX GUI: first valid software display present\n");
 				veux_fb_normal_status_clear();
 				veux_fb_touch_status_clear();
-				if (strcmp(veux_gui_init_process, "backboardd") == 0 ||
-				    strcmp(veux_gui_init_process, "SpringBoard") == 0)
-					veux_modem_gui_ready();
 				uint32_t quiet = 0;
 				if (PE_parse_boot_argn("veux_gui_noconsole", &quiet, sizeof(quiet)) && quiet == 1) {
 					veux_fb_gui_handoff();
 				}
 			}
+			veux_gui_modem_gate_try("present");
 			if (fConsolePaused && veux_modem_overlay_enabled) veux_fb_modem_log_draw();
 #endif
 		}
@@ -657,6 +682,7 @@
 	veux_gui_client_ready_count++;
 	veux_gui_save_process_name(veux_gui_ready_process);
 	IOLog("VEUX GUI: IOMFB client ready process=%s\n", name);
+	veux_gui_modem_gate_try("client-ready");
 #endif
 	return true;
 }
