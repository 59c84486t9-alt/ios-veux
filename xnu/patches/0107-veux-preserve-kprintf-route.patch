From: VEUX bring-up
Subject: [PATCH] Preserve the validated framebuffer sink through KPRINTF startup

--- a/pexpert/arm/pe_kprintf.c
+++ b/pexpert/arm/pe_kprintf.c
@@ -63,12 +63,6 @@
 
 #if defined(ARM64_BOARD_CONFIG_VEUX)
 static void
-veux_discard_kprintf(char c)
-{
-	(void)c;
-}
-
-static void
 veux_pmsg_putc_crlf(char c)
 {
 	if (c == '\n') {
@@ -84,21 +78,24 @@
 static void
 PE_init_kprintf(void)
 {
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	/* arm_vm_init already installed the opted-in, validated framebuffer sink.
+	 * UART discovery must not replace it with either a UART or discard sink. */
+	(void)serial_init();
+	PE_kputc = veux_pmsg_putc_crlf;
+	/* Direct banner proves routing independently of kprintf gating. */
+	const char *banner = "\nVEUX kprintf route active\n";
+	while (*banner) {
+		veux_pmsg_putc_crlf(*banner++);
+	}
+#else
 	if (serial_init()) {
 		PE_kputc = serial_putc_crlf;
 	} else {
-#if defined(ARM64_BOARD_CONFIG_VEUX)
-		/* Never draw on Qualcomm scanout until its handoff format is known. */
-		PE_kputc = veux_discard_kprintf;
-#else
-		/**
-		 * If serial failed to initialize then fall back to using the console,
-		 * and assume the console is using the video console (because clearly
-		 * serial doesn't work).
-		 */
+		/* If UART setup fails, use the platform console. */
 		PE_kputc = console_write_unbuffered;
-#endif
-	}
+	}
+#endif
 }
 STARTUP(KPRINTF, STARTUP_RANK_FIRST, PE_init_kprintf);
 
