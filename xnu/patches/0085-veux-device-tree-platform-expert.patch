+/*
+ * Minimal device-tree platform expert for Redmi Note 11 Pro 5G (veux).
+ * The iOS-facing root identity remains D22AP / iPhone10,3; the VEUX
+ * compatible string selects this board-specific expert and hardware tree.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+
+class VeuxPlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(VeuxPlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(VeuxPlatformExpert, IODTPlatformExpert);
+
+bool
+VeuxPlatformExpert::start(IOService *provider)
+{
+	IOLog("VEUX: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("VEUX: platform expert registered\n");
+	return true;
+}
+
+const char *
+VeuxPlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+VeuxPlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+VeuxPlatformExpert::processTopLevel(IORegistryEntry *root)
+{
+	/*
+	 * The base implementation requires an Apple NVRAM /options node.
+	 * VEUX has no compatible NVRAM controller, so publish the real CPU and
+	 * hardware nodes without invoking that assertion or inventing a node.
+	 */
+	IORegistryEntry *cpus = root->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
+}
+#endif /* ARM64_BOARD_CONFIG_VEUX */
