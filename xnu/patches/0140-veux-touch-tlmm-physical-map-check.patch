From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Report XNU VA to PA translation for VEUX TLMM

The active touch attempt reaches the correct stage but GPIO19 config reads
back zero after a write. Log the actual kernel page-table translation for the
mapped GPIO pages before touching any pin. This separates a bad VA-to-PA map
from an inaccessible or non-responsive TLMM block without changing GPIO state.

diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -12,6 +12,7 @@
 #include <sys/systm.h>
 #include <sys/errno.h>
 #include <kern/clock.h>
+#include <vm/pmap.h>
 #include <kern/thread.h>
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
@@ -21,4 +22,5 @@
 void sweet_touch_init(void);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #define TOUCH_SE_PA      0x00a84000u
@@ -136,6 +139,29 @@
 	return false;
 }
 
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+static void
+touch_tlmm_map_check(void)
+{
+	static const unsigned pins[] = {3, 19, 20, 21, 22, 44, 51};
+	printf("VEUX TOUCH MAPCHECK: kernel_pmap=%p TLMM va=%#llx pa=%#x page_shift=%u\n",
+	    pmap_kernel(), (unsigned long long)st.gpio, TOUCH_NORTH_PA, PAGE_SHIFT);
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); ++i) {
+		unsigned pin = pins[i];
+		vm_offset_t off = TOUCH_GPIO_CFG(pin);
+		vm_offset_t va = st.gpio + off;
+		uint64_t pa = (uint64_t)TOUCH_NORTH_PA + off;
+		ppnum_t actual = pmap_find_phys(pmap_kernel(), (addr64_t)va);
+		uint64_t expected = pa >> PAGE_SHIFT;
+		printf("VEUX TOUCH MAPCHECK: pin=%u cfg pa=%#llx va=%#llx actual_ppn=%#llx expected_ppn=%#llx match=%u cfg=%#x io=%#x\n",
+		    pin, (unsigned long long)pa, (unsigned long long)va,
+		    (unsigned long long)actual, (unsigned long long)expected,
+		    (uint64_t)actual == expected, touch_rd(st.gpio, off),
+		    touch_rd(st.gpio, off + 4u));
+	}
+}
+#endif
+
 static bool
 touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
 {
@@ -680,6 +706,7 @@
 	}
 #if defined(ARM64_BOARD_CONFIG_VEUX)
 	/* One run of read-only map/register diagnostics; do not alter clocks or GPIOs. */
+	touch_tlmm_map_check();
 	printf("VEUX TOUCH DIAG: before GCC vote read pa=%#x\n", TOUCH_GCC_PA + TOUCH_GCC_VOTE);
 	uint32_t vote = touch_rd(st.gcc, TOUCH_GCC_VOTE);
 	printf("VEUX TOUCH DIAG: GCC vote=%#x\n", vote);
-- 
