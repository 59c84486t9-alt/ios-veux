diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,6 +29,6 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET
+SUPPORTED_ARM64_MACHINE_CONFIGS = BCM2837 T6000 T8101 T8103 VMAPPLE SWEET VEUX
 
 endif
@@ -62,6 +62,7 @@ MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
+MACHINE_FLAGS_ARM64_VEUX = -DARM64_BOARD_CONFIG_VEUX                  -march=armv8.2-a+crypto
 
 
 #
@@ -263,7 +264,7 @@ export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CONFIG) | tr A-Z a-z)
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
-# sweet's Cortex-A76/A55 have no pointer authentication: stay plain arm64
+# SWEET and VEUX build profiles use plain arm64 pending device-specific validation
-ifneq ($(CURRENT_MACHINE_CONFIG),SWEET)
+ifeq ($(filter SWEET VEUX,$(CURRENT_MACHINE_CONFIG)),)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
 endif
 
