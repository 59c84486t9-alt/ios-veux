diff --git a/pexpert/pexpert/arm64/VEUX.h b/pexpert/pexpert/arm64/VEUX.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/VEUX.h
@@ -0,0 +1,35 @@
+/*
+ * Build profile for the Redmi Note 11 Pro 5G ("veux"), Qualcomm SM6375.
+ *
+ * This profile records architecture and topology facts from the selected
+ * board-matched FDT. It deliberately does not enable the SWEET hardware
+ * drivers: their addresses and display handoff assumptions are device-specific.
+ * It is a compile target, not yet a bootable VEUX kernel configuration.
+ */
+#ifndef _PEXPERT_ARM64_VEUX_H
+#define _PEXPERT_ARM64_VEUX_H
+
+#define NO_MONITOR                1
+#define VEUX                      1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+#define GIC_SPURIOUS_IRQ          1023
+#define GICR_PE_SIZE              0x20000
+
+/* Physical register bases verified in the selected VEUX FDT. */
+#define VEUX_GICD_BASE            0x0f200000ULL
+#define VEUX_GICR_BASE            0x0f240000ULL
+#define VEUX_UFS_BASE             0x04804000ULL
+
+#endif /* _PEXPERT_ARM64_VEUX_H */
