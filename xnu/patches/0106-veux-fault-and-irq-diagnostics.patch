From: VEUX bring-up
Subject: [PATCH] Retained-alias stage, fault and bounded IRQ diagnostics

diff --git a/osfmk/arm64/veux_early.c b/osfmk/arm64/veux_early.c
--- a/osfmk/arm64/veux_early.c
+++ b/osfmk/arm64/veux_early.c
@@ -52,7 +52,8 @@
 
 /* Low splash RAM is outside the high-bank physmap. start.s provides a
  * narrow identity alias; arm_vm_init switches us to a permanent kernel VA. */
-static uintptr_t veux_stage_fb = 0x85200000;
+uint32_t veux_exception_seen;
+uintptr_t veux_stage_fb = 0x85200000;
 void
 veux_early_relocate(uint64_t base)
 {
@@ -62,21 +63,23 @@
 void
 veux_stage_mark(unsigned int cell)
 {
-	static const uint32_t colors[6] = {
+	static const uint32_t colors[15] = {
 		0xffff0000u, 0xffff8000u, 0xffffff00u,
-		0xff00ff00u, 0xff00ffffu, 0xffff00ffu
+		0xff00ff00u, 0xff00ffffu, 0xffff00ffu,
+		0xffffffffu, 0xff80ff00u, 0xff0080ffu, 0xffff0080u,
+		0xff00ffffu, 0xffff8000u, 0xffff0000u, 0xff00ff00u, 0xff8000ffu
 	};
-	if (cell >= 6) return;
+	if (cell >= 15) return;
+	unsigned int row = cell < 6 ? 2304 : 2352;
+	unsigned int col = cell < 6 ? cell : cell - 6;
 	volatile uint32_t *fb = (volatile uint32_t *)veux_stage_fb;
-	for (unsigned int y = 2304; y < 2336; y++) {
-		for (unsigned int x = 32 + cell * 64; x < 64 + cell * 64; x++) {
+	for (unsigned int y = row; y < row + 32; y++) {
+		for (unsigned int x = 32 + col * 64; x < 64 + col * 64; x++) {
 			fb[y * (4320 / 4) + x] = colors[cell];
 		}
 	}
 	__asm__ volatile("dsb sy" ::: "memory");
-	veux_early_string("VEUX COLOR CELL ");
-	veux_early_uint(cell);
-	veux_early_putc('\n');
+	/* Exception-safe: no log writer or formatter in the paint path. */
 }
 
 void
@@ -98,6 +101,12 @@
 		return;
 	}
 	veux_early_panicking = true;
+	veux_stage_mark(12);
+	/* Snapshot current EL1 syndrome; preserve a prior synchronous fault dump. */
+	uint64_t sp;
+	__asm__ volatile("mov %0, sp" : "=r"(sp));
+	veux_fault_dump(__builtin_arm_rsr64("ESR_EL1"),
+	    __builtin_arm_rsr64("ELR_EL1"), __builtin_arm_rsr64("FAR_EL1"), sp);
 	veux_early_string("\nVEUX EARLY PANIC: ");
 	va_list copy;
 	va_copy(copy, *args);
