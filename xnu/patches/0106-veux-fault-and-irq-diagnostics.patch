diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -26,6 +26,89 @@
 static vm_offset_t gicd_base;
 static vm_offset_t gicr_base;
 static vm_offset_t gicr_size;
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+static uint32_t _gic_read32(vm_offset_t addr);
+static vm_offset_t veux_probe_gicr;
+static volatile unsigned int veux_probe_active, veux_probe_delivered;
+static bool veux_probe_ran;
+
+/* Intercept only during the bounded probe, before rtclock/scheduler startup.
+ * Assembly interrupt bookkeeping still runs and is balanced on return. */
+int
+veux_probe_interrupt(unsigned int group)
+{
+ if (!veux_probe_active) return 0;
+ uint64_t iar = group ? __builtin_arm_rsr64("ICC_IAR1_EL1") :
+     __builtin_arm_rsr64("ICC_IAR0_EL1");
+ uint32_t intid = iar & 0xffffff;
+ if (intid == arm64_vtimer_intid) {
+  __builtin_arm_wsr64("CNTV_CTL_EL0", 2); /* disable and mask before EOI */
+  __builtin_arm_isb(ISB_SY);
+  veux_probe_delivered = group ? 1 : 2;
+  veux_stage_mark(13);
+ }
+ if (intid < 1020) {
+  if (group) __builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+  else __builtin_arm_wsr64("ICC_EOIR0_EL1", iar);
+  __builtin_arm_isb(ISB_SY);
+ }
+ return 1;
+}
+
+void
+veux_irq_probe(void)
+{
+ if (veux_probe_ran) return;
+ veux_probe_ran = true;
+ uint64_t daif = __builtin_arm_rsr64("DAIF");
+ __asm__ volatile("msr daifset, #3" ::: "memory");
+ uint64_t old_ctl = __builtin_arm_rsr64("CNTV_CTL_EL0");
+ uint64_t old_cval = __builtin_arm_rsr64("CNTV_CVAL_EL0");
+ uint64_t freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+ if (!freq || !veux_probe_gicr || !gicd_base) {
+  veux_stage_mark(14);
+  veux_bit_row(freq, 1800);
+  __builtin_arm_wsr64("DAIF", daif);
+  return;
+ }
+ __builtin_arm_wsr64("CNTV_CTL_EL0", 2);
+ __builtin_arm_wsr64("CNTV_TVAL_EL0", freq / 1000 ? freq / 1000 : 1);
+ veux_probe_active = 1;
+ __builtin_arm_wsr64("CNTV_CTL_EL0", 1);
+ __builtin_arm_isb(ISB_SY);
+ uint64_t start = __builtin_arm_rsr64("CNTVCT_EL0");
+ veux_stage_mark(9); /* immediately before this probe's IRQ/FIQ unmask */
+ __asm__ volatile("msr daifclr, #3; isb" ::: "memory");
+ while (!veux_probe_delivered &&
+     __builtin_arm_rsr64("CNTVCT_EL0") - start < freq / 20) {
+  __asm__ volatile("yield");
+ }
+ __asm__ volatile("msr daifset, #3; isb" ::: "memory");
+ if (!veux_probe_delivered) {
+  /* Snapshot before restoring/masking the virtual timer. Rows top to bottom. */
+  veux_stage_mark(14);
+  veux_bit_row(__builtin_arm_rsr64("CNTV_CTL_EL0"), 1800);
+  veux_bit_row(_gic_read32(veux_probe_gicr + 0x10200 /* SGI frame ISPENDR0 */), 1824);
+  veux_bit_row(_gic_read32(veux_probe_gicr + GICR_ISENABLER0), 1848);
+  veux_bit_row(_gic_read32(veux_probe_gicr + GICR_IGROUPR0), 1872);
+  veux_bit_row(*(volatile uint8_t *)(veux_probe_gicr + GICR_IPRIORITYR0 + 19), 1896);
+  veux_bit_row(_gic_read32(veux_probe_gicr + GICR_WAKER), 1920);
+  veux_bit_row(_gic_read32(gicd_base + GICD_CTLR), 1944);
+  veux_bit_row(__builtin_arm_rsr64("ICC_SRE_EL1"), 1968);
+  veux_bit_row(__builtin_arm_rsr64("ICC_PMR_EL1"), 1992);
+  veux_bit_row(__builtin_arm_rsr64("ICC_IGRPEN0_EL1"), 2016);
+  veux_bit_row(__builtin_arm_rsr64("ICC_IGRPEN1_EL1"), 2040);
+ }
+ __builtin_arm_wsr64("CNTV_CTL_EL0", 2);
+ __builtin_arm_isb(ISB_SY);
+ veux_probe_active = 0;
+ __builtin_arm_wsr64("CNTV_CVAL_EL0", old_cval);
+ __builtin_arm_wsr64("CNTV_CTL_EL0", old_ctl);
+ __builtin_arm_isb(ISB_SY);
+ __builtin_arm_wsr64("DAIF", daif);
+}
+#endif
+
 
 static uint32_t
 _gic_read32(vm_offset_t addr)
@@ -146,6 +229,9 @@
 
 	// Find the redistributor for this processor
 	vm_offset_t gicr_pe_base = find_gicr_pe_base();
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+ veux_probe_gicr = gicr_pe_base;
+#endif
 
 	// Mark this PE to be awake
 	uint32_t gicr_waker = gicr_read32(GICR_WAKER);
