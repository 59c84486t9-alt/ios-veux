diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -1025,3 +1025,75 @@
 //#include	"globals_asm.h"
 
 /* vim: set ts=4: */
+
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+/* Leaf renderers: no stack, calls, fonts, allocation, or logging. x0-x17 scratch.
+ * 64 cells, MSB left, 16px square/pitch, x=28. Retained early alias only. */
+.text
+.align 2
+.globl EXT(veux_bit_row)
+LEXT(veux_bit_row)
+ adrp x4, EXT(veux_stage_fb)@page
+ ldr x4, [x4, EXT(veux_stage_fb)@pageoff]
+ mov x5, #4320
+ madd x4, x1, x5, x4
+ add x4, x4, #112
+ mov x6, #64
+1:
+ movz w7, #0x2020
+ movk w7, #0xff20, lsl #16
+ tbz x0, #63, 2f
+ mov w7, #-1
+2:
+ mov x8, x4
+ mov x9, #16
+3:
+ mov x10, #16
+ mov x11, x8
+4:
+ str w7, [x11], #4
+ subs x10, x10, #1
+ b.ne 4b
+ add x8, x8, x5
+ subs x9, x9, #1
+ b.ne 3b
+ lsl x0, x0, #1
+ add x4, x4, #64
+ subs x6, x6, #1
+ b.ne 1b
+ dsb sy
+ ret
+
+/* First fault wins so panic cannot replace the synchronous fault's PC/SP.
+ * Keep input values in caller-scratch regs untouched by the leaf above. */
+.globl EXT(veux_fault_dump)
+LEXT(veux_fault_dump)
+ adrp x4, Lveux_fault_seen@page
+ add x4, x4, Lveux_fault_seen@pageoff
+ ldr w5, [x4]
+ cbnz w5, 5f
+ mov w5, #1
+ str w5, [x4]
+ mov x12, x30
+ mov x13, x1
+ mov x14, x2
+ mov x15, x3
+ mov x1, #2120
+ bl EXT(veux_bit_row)
+ mov x0, x13
+ mov x1, #2144
+ bl EXT(veux_bit_row)
+ mov x0, x14
+ mov x1, #2168
+ bl EXT(veux_bit_row)
+ mov x0, x15
+ mov x1, #2192
+ bl EXT(veux_bit_row)
+ mov x30, x12
+5:
+ ret
+.data
+.align 2
+Lveux_fault_seen:
+ .long 0
+#endif
diff --git a/osfmk/arm64/locore.s b/osfmk/arm64/locore.s
--- a/osfmk/arm64/locore.s
+++ b/osfmk/arm64/locore.s
@@ -578,8 +578,43 @@
 
 	.text
 	.align 2
+
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+/* FLEH entered with registers saved. Only x9-x14 clobbered; no stack use. */
+.macro VEUX_EXCEPTION_CELL
+ adrp x9, EXT(veux_exception_seen)@page
+ add x9, x9, EXT(veux_exception_seen)@pageoff
+ ldr w10, [x9]
+ tbnz w10, $0, 9f
+ orr w10, w10, #(1 << $0)
+ str w10, [x9]
+ adrp x9, EXT(veux_stage_fb)@page
+ ldr x9, [x9, EXT(veux_stage_fb)@pageoff]
+ MOV64 x10, (2352 * 4320 + (32 + 64 * $0) * 4)
+ add x9, x9, x10
+ MOV64 x10, $1
+ mov x11, #32
+1:
+ mov x12, #32
+ mov x13, x9
+2:
+ str w10, [x13], #4
+ subs x12, x12, #1
+ b.ne 2b
+ mov x14, #4320
+ add x9, x9, x14
+ subs x11, x11, #1
+ b.ne 1b
+ dsb sy
+9:
+.endmacro
+#endif
+
 	.global EXT(fleh_synchronous)
 LEXT(fleh_synchronous)
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+ VEUX_EXCEPTION_CELL 5, 0xffff8000
+#endif
 	
 UNWIND_PROLOGUE
 UNWIND_DIRECTIVES	
@@ -676,6 +711,9 @@
 	.align 2
 	.global EXT(fleh_irq)
 LEXT(fleh_irq)
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+ VEUX_EXCEPTION_CELL 4, 0xff00ffff
+#endif
 UNWIND_PROLOGUE
 UNWIND_DIRECTIVES
 	BEGIN_INTERRUPT_HANDLER
@@ -702,6 +740,9 @@
 	.align 2
 	.global EXT(fleh_fiq)
 LEXT(fleh_fiq)
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+ VEUX_EXCEPTION_CELL 4, 0xff00ffff
+#endif
 UNWIND_PROLOGUE
 UNWIND_DIRECTIVES
 	BEGIN_INTERRUPT_HANDLER
@@ -756,6 +797,9 @@
 	.text
 	.align 2
 fleh_synchronous_sp1:
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+ VEUX_EXCEPTION_CELL 5, 0xffff8000
+#endif
 	mrs		x1, ESR_EL1							// Load exception syndrome
 	str		x1, [x0, SS64_ESR]
 	mrs		x2, FAR_EL1							// Load fault address
@@ -767,6 +811,9 @@
 	.text
 	.align 2
 fleh_irq_sp1:
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+ VEUX_EXCEPTION_CELL 4, 0xff00ffff
+#endif
 	mov		x1, x0
 	adr		x0, Lsp1_irq_str
 	b		EXT(panic_with_thread_kernel_state)
@@ -776,6 +823,9 @@
 	.text
 	.align 2
 fleh_fiq_sp1:
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+ VEUX_EXCEPTION_CELL 4, 0xff00ffff
+#endif
 	mov		x1, x0
 	adr		x0, Lsp1_fiq_str
 	b		EXT(panic_with_thread_kernel_state)
