From: ios-veux
Subject: [PATCH] Report VEUX mount mode and first UFS writes

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -329,7 +329,22 @@
 		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
 		0, (uint8_t)(count >> 8), (uint8_t)count, 0
 	};
-	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+	int error = ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	static bool veux_first_write_seen, veux_first_write_error_seen;
+	if (error && !veux_first_write_error_seen) {
+		veux_first_write_error_seen = true;
+		veux_bsd_stage(21); /* first UFS write failure */
+		printf("VEUX UFS: first UFS write failure error=0x%x lba=0x%llx count=0x%x\n",
+		    error, lba, count);
+	} else if (!error && !veux_first_write_seen) {
+		veux_first_write_seen = true;
+		veux_bsd_stage(20); /* first successful UFS write */
+		printf("VEUX UFS: first successful UFS write lba=0x%llx count=0x%x\n",
+		    lba, count);
+	}
+#endif
+	return error;
 }
 
 static int
diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -4884,6 +4884,13 @@
 {
 	struct __mac_execve_args muap;
 	int err;
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	if (strncmp(p->p_comm, "mount", 5) == 0) {
+		extern void veux_bsd_stage(unsigned int stage);
+		veux_bsd_stage(18); /* mount helper exec entry */
+		printf("VEUX MOUNT helper start name=%s\n", p->p_comm);
+	}
+#endif
 
 	memoryshot(VM_EXECVE, DBG_FUNC_NONE);
 
diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1844,6 +1844,13 @@
 	struct rusage_superset *rup;
 	int kr = 0;
 	int create_corpse = FALSE;
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+	if (strncmp(p->p_comm, "mount", 5) == 0) {
+		extern void veux_bsd_stage(unsigned int stage);
+		veux_bsd_stage(19); /* mount helper exit */
+		printf("VEUX MOUNT helper exit raw-status=0x%x\n", rv);
+	}
+#endif
 
 	if (p->p_crash_behavior != 0 || p == initproc) {
 		proc_handle_critical_exit(p, rv);
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -888,6 +888,7 @@
 		err = vfs_mountroot();
 #if defined(ARM64_BOARD_CONFIG_VEUX)
 		veux_bsd_stage(9); /* vfs_mountroot exit */
+		printf("VEUX ROOT mount result errno=0x%x\n", err);
 #endif
 		if (0 == err) {
 #if defined(ARM64_BOARD_CONFIG_VEUX)
diff --git a/bsd/vfs/vfs_subr.c b/bsd/vfs/vfs_subr.c
--- a/bsd/vfs/vfs_subr.c
+++ b/bsd/vfs/vfs_subr.c
@@ -1214,6 +1214,11 @@
 {
 #if defined(ARM64_BOARD_CONFIG_VEUX)
 	veux_bsd_stage(8); /* vfs_mountroot entry */
+	uint32_t rootrw = 0, ufsrw = 0;
+	PE_parse_boot_argn("rootrw", &rootrw, sizeof(rootrw));
+	PE_parse_boot_argn("ufsrw", &ufsrw, sizeof(ufsrw));
+	printf("VEUX ROOT mode=%s ufs_write=%s (read-only default; rw requires rootrw=1 and ufsrw=1)\n", rootrw == 1 ? "rw" : "ro",
+	    ufsrw == 1 ? "enabled" : "disabled");
 #endif
 #if CONFIG_MACF
 	struct vnode *vp;
diff --git a/osfmk/arm64/veux_early.c b/osfmk/arm64/veux_early.c
--- a/osfmk/arm64/veux_early.c
+++ b/osfmk/arm64/veux_early.c
@@ -781,8 +781,8 @@
 void
 veux_bsd_stage(unsigned int stage)
 {
- static const uint32_t colors[18] = {0xffffffff,0xffffff00,0xff00ff00,0xffff8000,0xff00ffff,0xffff00ff,0xffff0000,0xff0080ff,0xff80ff00,0xffff8000,0xff00ffff,0xffff00ff,0xffffffff,0xff4040ff,0xff40ff40,0xffff4040,0xff40ff40,0xffff2020};
- if (stage >= 18) return;
+ static const uint32_t colors[22] = {0xffffffff,0xffffff00,0xff00ff00,0xffff8000,0xff00ffff,0xffff00ff,0xffff0000,0xff0080ff,0xff80ff00,0xffff8000,0xff00ffff,0xffff00ff,0xffffffff,0xff4040ff,0xff40ff40,0xffff4040,0xff40ff40,0xffff2020,0xff00ffff,0xffff00ff,0xff40ff40,0xffff2020};
+ if (stage >= 22) return;
  vw_bsd_mask |= 1ULL << stage;
  volatile uint32_t *fb = (volatile uint32_t *)veux_stage_fb;
  unsigned cell = stage < 16 ? stage : stage - 16;
