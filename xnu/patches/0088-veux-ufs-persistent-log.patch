+
+#if defined(ARM64_BOARD_CONFIG_VEUX)
+/*
+ * VEUX early console ring. The ring is filled from the first console call,
+ * then flushed only to a fixed 4 MiB + header window at the end of userdata.
+ * Android's encrypted F2FS cannot expose this as a live file; recovery can
+ * read the bounded raw window and tools/veux-log.py turns it into a host file.
+ */
+#define VEUX_LOG_SIZE          (4u << 20)
+#define VEUX_LOG_BLOCKS        (1 + VEUX_LOG_SIZE / UFS_BLOCK)
+
+static char veux_log_ring[VEUX_LOG_SIZE];
+static uint64_t _Atomic veux_log_total;
+static uint32_t _Atomic veux_log_lock;
+static int veux_log_chan;
+static bool veux_log_started;
+
+struct veux_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+void
+veux_log_append(const char *c, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	/* Console output may arrive in panic or interrupt context. Drop a byte
+	 * rather than wait on another writer, and publish it only after storage. */
+	for (int i = 0; i < size; i++) {
+		if (!os_atomic_cmpxchg(&veux_log_lock, 0, 1, acquire)) continue;
+		uint64_t at = os_atomic_load(&veux_log_total, relaxed);
+		veux_log_ring[at % VEUX_LOG_SIZE] = c[i];
+		os_atomic_store(&veux_log_total, at + 1, release);
+		os_atomic_store(&veux_log_lock, 0, release);
+	}
+}
+
+/* Best-effort synchronous snapshot for reboot and panic paths. Never wait for
+ * the UFS lock here: shutdown may have interrupted its owner. */
+int
+veux_log_flush_sync(void)
+{
+	if (!veux_log_started || !su.log_write_enabled || !su.ready) return ENXIO;
+	if (!lck_mtx_try_lock(&sweet_ufs_lock)) return EBUSY;
+	uint64_t total = os_atomic_load(&veux_log_total, relaxed);
+	uint64_t pos = total > VEUX_LOG_SIZE ? total - VEUX_LOG_SIZE : 0;
+	uint64_t base = su.log_first_block;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	int error = 0;
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % VEUX_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(VEUX_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, veux_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		struct veux_log_header h = {
+			.magic = { 'V', 'E', 'U', 'X', 'L', 'O', 'G', '1' },
+			.version = 1, .size = VEUX_LOG_SIZE, .total = total, .seq = total,
+		};
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+	}
+	if (!error) error = ufs_sync_cache();
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
+
+static void
+veux_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = su.log_first_block;
+	uint64_t flushed = 0, seq = 0;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	printf("VEUX LOG: bounded userdata tail at block 0x%llx (%u KiB)\n",
+	    base, VEUX_LOG_BLOCKS * UFS_BLOCK >> 10);
+	for (;;) {
+		uint64_t total = os_atomic_load(&veux_log_total, acquire);
+		if (total != flushed) {
+			uint64_t pos = total - flushed >= VEUX_LOG_SIZE ? total - VEUX_LOG_SIZE : flushed;
+			int error = 0;
+			lck_mtx_lock(&sweet_ufs_lock);
+			while (pos < total && !error) {
+				uint32_t off = (uint32_t)(pos % VEUX_LOG_SIZE);
+				uint32_t blk = off / UFS_BLOCK;
+				uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+				uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(VEUX_LOG_SIZE / UFS_BLOCK - blk)), 64u);
+				while (!os_atomic_cmpxchg(&veux_log_lock, 0, 1, acquire)) __asm__ volatile("yield");
+				uint64_t live_total = os_atomic_load(&veux_log_total, acquire);
+				if (live_total > pos && live_total - pos > VEUX_LOG_SIZE) {
+					total = live_total;
+					pos = total - VEUX_LOG_SIZE;
+					off = (uint32_t)(pos % VEUX_LOG_SIZE);
+					blk = off / UFS_BLOCK;
+					need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+					n = (uint32_t)MIN(MIN(need, (uint64_t)(VEUX_LOG_SIZE / UFS_BLOCK - blk)), 64u);
+				}
+				memcpy(bounce, veux_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+				os_atomic_store(&veux_log_lock, 0, release);
+				error = ufs_write_blocks(base + 1 + blk, n);
+				pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+			}
+			if (!error) {
+				struct veux_log_header h = {
+					.magic = { 'V', 'E', 'U', 'X', 'L', 'O', 'G', '1' },
+					.version = 1, .size = VEUX_LOG_SIZE,
+					.total = total, .seq = ++seq,
+				};
+				bzero(bounce, UFS_BLOCK);
+				memcpy(bounce, &h, sizeof(h));
+				error = ufs_write_blocks(base, 1);
+			}
+			if (!error) {
+				error = ufs_sync_cache();
+			}
+			lck_mtx_unlock(&sweet_ufs_lock);
+			if (error) {
+				printf("VEUX LOG: write failed (%d), stopping\n", error);
+				return;
+			}
+			flushed = total;
+		}
+		(void)tsleep(&veux_log_chan, PZERO, "veuxlog", hz);
+	}
+}
+
+static void
+veux_log_start(bool userdata_partition)
+{
+	uint32_t on = 0;
+	thread_t thread;
+	if (!PE_parse_boot_argn("veuxlog", &on, sizeof(on)) || on != 1 ||
+	    !userdata_partition || su.lun != 0 || su.nblocks < 2 * VEUX_LOG_BLOCKS) {
+		return;
+	}
+	su.log_first_block = su.first_block + su.nblocks - VEUX_LOG_BLOCKS;
+	su.log_nblocks = VEUX_LOG_BLOCKS;
+	if (!veux_log_started) {
+		su.log_write_enabled = true;
+		if (kernel_thread_start(veux_log_thread, NULL, &thread) == KERN_SUCCESS) {
+			veux_log_started = true;
+			thread_deallocate(thread);
+		} else {
+			su.log_write_enabled = false;
+		}
+	}
+}
+#endif
 
